
@model QuanLyThuVien.ViewModels.DangNhapViewModel

@{
    Layout = null;
    ViewData["Title"] = "Login - Librista";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>Librista - Login & Register</title>

    <link rel="stylesheet"
          href="~/css/account-lamp.css"
          asp-append-version="true" />
</head>

<body>
<main class="auth-page">

    <a class="brand" href="/">
        <span class="brand-icon">✦</span>
        <span>
            <strong>Librista</strong>
            <small>LIBRARY MANAGEMENT SYSTEM</small>
        </span>
    </a>

    <div class="auth-box" id="authBox">

        <!-- ========================= -->
        <!-- FORM LOGIN BÊN PHẢI      -->
        <!-- ========================= -->

        <section class="form-side login-side"
                 id="loginSide">

            <form id="loginForm"
                  asp-area=""
                  asp-controller="Account"
                  asp-action="Login"
                  method="post">

                @Html.AntiForgeryToken()

                <h1>Login</h1>

                <p class="form-subtitle">
                    Đăng nhập vào thư viện của bạn
                </p>

                <div asp-validation-summary="ModelOnly"
                     class="validation-error"
                     role="alert"></div>

                <label asp-for="TenDangNhap">
                    Username
                </label>

                <div class="field">
                    <input asp-for="TenDangNhap"
                           type="text"
                           placeholder="Username"
                           autocomplete="username" />

                    <span class="field-icon">♙</span>
                </div>

                <span asp-validation-for="TenDangNhap"
                      class="field-error"></span>

                <label asp-for="MatKhau">
                    Password
                </label>

                <div class="field">
                    <input asp-for="MatKhau"
                           type="password"
                           placeholder="Password"
                           autocomplete="current-password" />

                    <button type="button"
                            class="password-toggle"
                            data-target="MatKhau"
                            aria-label="Hiện mật khẩu">
                        ◉
                    </button>
                </div>

                <span asp-validation-for="MatKhau"
                      class="field-error"></span>

                <label class="remember">
                    <input asp-for="GhiNho" />
                    <span>Remember me</span>
                </label>

                <button type="submit"
                        class="primary-button">
                    Login
                </button>

                <p class="form-switch">
                    Don't have an account?
                    <button type="button"
                            data-mode="register">
                        Register
                    </button>
                </p>

            </form>
        </section>

        <!-- ========================= -->
        <!-- FORM REGISTER BÊN TRÁI   -->
        <!-- ========================= -->

        <section class="form-side register-side"
                 id="registerSide"
                 aria-hidden="true"
                 inert>

            <form id="registerForm">

                <h1>Registration</h1>

                <p class="form-subtitle">
                    Tạo tài khoản thư viện mới
                </p>

                <label for="regUsername">Username</label>
                <div class="field">
                    <input id="regUsername"
                           type="text"
                           placeholder="Username"
                           autocomplete="username" />
                    <span class="field-icon">♙</span>
                </div>

                <label for="regFullName">Full name</label>
                <div class="field">
                    <input id="regFullName"
                           type="text"
                           placeholder="Full name"
                           autocomplete="name" />
                    <span class="field-icon">♙</span>
                </div>

                <label for="regEmail">Email</label>
                <div class="field">
                    <input id="regEmail"
                           type="email"
                           placeholder="Email"
                           autocomplete="email" />
                    <span class="field-icon">&#64;</span>
                </div>

                <label for="regPassword">Password</label>
                <div class="field">
                    <input id="regPassword"
                           type="password"
                           placeholder="Password"
                           autocomplete="new-password" />
                    <button type="button"
                            class="password-toggle"
                            data-target="regPassword"
                            aria-label="Hiện mật khẩu">
                        ◉
                    </button>
                </div>

                <label for="regConfirm">Confirm password</label>
                <div class="field">
                    <input id="regConfirm"
                           type="password"
                           placeholder="Confirm password"
                           autocomplete="new-password" />
                    <button type="button"
                            class="password-toggle"
                            data-target="regConfirm"
                            aria-label="Hiện mật khẩu">
                        ◉
                    </button>
                </div>

                <p class="register-note">
                    Chức năng đăng ký chưa được kết nối
                    SQL Server.
                </p>

                <button type="button"
                        class="primary-button"
                        disabled>
                    Register
                </button>

                <p class="form-switch">
                    Already have an account?
                    <button type="button"
                            data-mode="login">
                        Login
                    </button>
                </p>

            </form>
        </section>

        <!-- ========================= -->
        <!-- MẢNG XANH TRƯỢT          -->
        <!-- ========================= -->

        <div class="color-panel" id="colorPanel">

            <div class="panel-content panel-register"
                 id="panelRegister">

                <h2>Hello, Welcome!</h2>
                <p>Don't have an account?</p>

                <button type="button"
                        class="outline-button"
                        id="switchRegister">
                    Register
                </button>
            </div>

            <div class="panel-content panel-login"
                 id="panelLogin"
                 aria-hidden="true"
                 inert>

                <h2>Welcome Back!</h2>
                <p>Already have an account?</p>

                <button type="button"
                        class="outline-button"
                        id="switchLogin">
                    Login
                </button>
            </div>

        </div>

    </div>

    <footer>
        © Librista · Library Management System
    </footer>

</main>

<script src="~/js/account-lamp.js"
        asp-append-version="true"></script>

</body>
</html>

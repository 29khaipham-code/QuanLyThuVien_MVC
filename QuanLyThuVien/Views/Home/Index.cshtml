                </details>
            </div>
        </section>

        <!-- NEWSLETTER -->
        <section class="sample-section newsletter-section">
            <div class="newsletter-card" data-aos="fade-up">
                <div class="newsletter-copy">
                    <p class="eyebrow">GHI CHÚ ĐỌC SÁCH</p>

@{
    ViewData["Title"] = "Trang chủ";
}

<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />

<div class="library-home" id="trang-chu">
    <header class="library-nav">
        <a asp-controller="Home" asp-action="Index" class="library-brand">
            <span class="brand-symbol">B.</span>
            <span>THƯ VIỆN SỐ</span>
        </a>

        <nav class="library-nav-links" aria-label="Điều hướng chính">
            <a href="#trang-chu">Trang chủ</a>
            <a href="#gioi-thieu">Giới thiệu</a>
            <a href="#bo-suu-tap">Bộ sưu tập</a>
            <a href="#kham-pha">Khám phá</a>
            <a href="#quy-trinh">Quy trình</a>
            <a href="#faq">Hỏi đáp</a>
        </nav>

        <a asp-controller="Account" asp-action="Login" class="nav-account">
            Đăng nhập <span>↗</span>
        </a>
    </header>

    <main>
        <!-- 01. HERO -->
        <section class="lib-hero">
            <div class="hero-copy">
                <p class="eyebrow"><span></span> KHÔNG GIAN TRI THỨC · 2026</p>
                <h1>Mở từng trang sách,<br /><em>chạm đến thế giới.</em></h1>
                <p class="hero-lead">
                    Một không gian đọc gần gũi, nơi bạn có thể tìm kiếm tài liệu,
                    khám phá những chủ đề mới và nuôi dưỡng niềm yêu thích học hỏi.
                </p>
                <div class="hero-actions">
                    <a asp-controller="Home" asp-action="DanhSachSach" class="btn-clay">
                        Khám phá sách <span>↗</span>
                    </a>
                    <a href="#gioi-thieu" class="btn-paper">Về thư viện</a>
                </div>
                <div class="hero-meta">
                    <span>● Đọc mỗi ngày</span>
                    <span>● Học điều mới</span>
                    <span>● Mở rộng góc nhìn</span>
                </div>
            </div>
            <div class="hero-art">
                <img src="https://images.unsplash.com/photo-1507842217343-583bb7270b66?auto=format&fit=crop&w=1200&q=85"
                     alt="Không gian thư viện với những kệ sách" fetchpriority="high" />
                <div class="hero-image-note">
                    <span>GÓC ĐỌC CỦA BẠN</span>
                    <strong>Find a quiet place. Open a new world.</strong>
                </div>
                <span class="hero-stamp">READ<br />MORE</span>
            </div>
        </section>

        <!-- 02. PALETTE / ĐỊNH HƯỚNG MÀU SẮC -->
        <section class="sample-section palette-section" id="gioi-thieu">
            <div class="section-heading">
                <p class="eyebrow">BẢN SẮC THƯ VIỆN</p>
                <h2>Một bảng màu của tri thức.</h2>
                <p>Ấm áp như trang giấy, trầm tĩnh như một góc đọc và nổi bật vừa đủ để dẫn lối khám phá.</p>
            </div>
            <div class="palette-grid">
                <div class="palette-chip"><span class="swatch swatch-paper"></span><b>Giấy ngà</b><small>#F5F0E8</small></div>
                <div class="palette-chip"><span class="swatch swatch-sand"></span><b>Cát ấm</b><small>#E8DED0</small></div>
                <div class="palette-chip"><span class="swatch swatch-clay"></span><b>Đất nung</b><small>#C96B4B</small></div>
                <div class="palette-chip"><span class="swatch swatch-ink"></span><b>Mực nâu</b><small>#29251F</small></div>
                <div class="palette-chip"><span class="swatch swatch-olive"></span><b>Olive</b><small>#87916B</small></div>
                <div class="palette-chip"><span class="swatch swatch-linen"></span><b>Vải lanh</b><small>#D7C6AD</small></div>
            </div>
            <div class="palette-note">
                <span class="palette-note-swatch"></span>
                <div>
                    <strong>Đất nung · Màu nhấn chính</strong>
                    <p>Dùng cho nút hành động, liên kết quan trọng và những điểm cần được chú ý.</p>
                </div>
                <span class="mini-pill">Màu chủ đạo</span>
            </div>
        </section>

        <!-- 03. TYPOGRAPHY -->
        <section class="sample-section type-section">
            <div class="section-heading">
                <p class="eyebrow">NGÔN NGỮ THỊ GIÁC</p>
                <h2>Chữ nghĩa có chiều sâu.</h2>
                <p>Kiểu chữ có chân tạo cảm giác gần gũi với sách in; phần nội dung vẫn rõ ràng và dễ đọc.</p>
            </div>
            <div class="type-specimen">
                <div class="type-row type-display">
                    <small>TIÊU ĐỀ LỚN</small>
                    <strong>Những trang sách<br />mở lối tương lai.</strong>
                    <em>Display serif · 56 px</em>
                </div>
                <div class="type-row">
                    <small>TIÊU ĐỀ MỤC</small>
                    <strong>Khám phá kho tàng tri thức</strong>
                    <em>Section title · 32 px</em>
                </div>
                <div class="type-row">
                    <small>TÊN THẺ</small>
                    <strong>Một cuốn sách đáng đọc</strong>
                    <em>Card title · 20 px</em>
                </div>
                <div class="type-row">
                    <small>NỘI DUNG</small>
                    <span>Mỗi cuốn sách là một hành trình, mỗi trang sách là một cơ hội để hiểu thêm về thế giới quanh ta.</span>
                    <em>Body text · 15 px</em>
                </div>
                <div class="type-row">
                    <small>Nhãn</small>
                    <span class="type-label">BỘ SƯU TẬP · 2026</span>
                    <em>Eyebrow · 10 px</em>
                </div>
            </div>
        </section>

        <!-- 04. BUTTONS -->
        <section class="sample-section button-section">
            <div class="section-heading">
                <p class="eyebrow">TƯƠNG TÁC</p>
                <h2>Nút bấm thân thiện.</h2>
                <p>Mỗi thao tác được thể hiện rõ ràng, nhất quán và dễ nhận biết.</p>
            </div>
            <div class="button-showcase">
                <a asp-controller="Home" asp-action="DanhSachSach" class="btn-clay">Khám phá sách</a>
                <a asp-controller="Account" asp-action="Login" class="btn-olive">Đăng nhập</a>
                <a href="#bo-suu-tap" class="btn-paper">Bộ sưu tập</a>
                <a href="#quy-trinh" class="btn-outline">Cách sử dụng</a>
                <a href="#faq" class="btn-icon" aria-label="Đi đến câu hỏi thường gặp">↗</a>
                <span class="button-disabled">Sắp ra mắt</span>
            </div>
            <p class="sample-caption">Nút chính dùng màu đất nung · Nút phụ dùng olive · Nút viền dành cho thao tác ít ưu tiên hơn.</p>
        </section>

        <!-- 05. SURFACE CARDS -->
        <section class="sample-section surfaces-section">
            <div class="section-heading">
                <p class="eyebrow">BỀ MẶT GIAO DIỆN</p>
                <h2>Những tấm thẻ xếp lớp.</h2>
                <p>Các bề mặt giấy, màu cát và đất nung tạo chiều sâu nhẹ nhàng cho nội dung.</p>
            </div>
            <div class="surface-grid">
                <article class="surface-card surface-project">
                    <small>GÓC ĐỌC</small>
                    <h3>Không gian yên tĩnh</h3>
                    <p>Một nơi để tạm dừng, đọc chậm và dành thời gian cho điều bạn yêu thích.</p>
                    <span>● Đọc & suy ngẫm</span>
                </article>
                <article class="surface-card surface-paper">
                    <small>KHÁM PHÁ</small>
                    <h3>Thế giới trong trang sách</h3>
                    <p>Từ văn học, công nghệ đến khoa học và đời sống.</p>
                    <a asp-controller="Home" asp-action="DanhSachSach">Xem danh mục ↗</a>
                </article>
                <article class="surface-card surface-clay">
                    <small>BẠN ĐỌC MỚI</small>
                    <h3>Bắt đầu hành trình đọc</h3>
                    <p>Đăng nhập để tiếp tục sử dụng những chức năng dành cho bạn đọc.</p>
                    <a asp-controller="Account" asp-action="Login" class="surface-light-link">Đăng nhập ↗</a>
                </article>
            </div>
            <div class="stat-strip">
                <div><strong>01</strong><span>Tìm kiếm</span></div>
                <div><strong>02</strong><span>Khám phá</span></div>
                <div><strong>03</strong><span>Đọc và học</span></div>
                <div><strong>∞</strong><span>Ý tưởng mới</span></div>
            </div>
        </section>

        <!-- 06. SUPPORT FORM -->
        <section class="sample-section support-section" id="ho-tro">
            <div class="section-heading">
                <p class="eyebrow">KẾT NỐI VỚI THƯ VIỆN</p>
                <h2>Bắt đầu một cuộc trò chuyện.</h2>
                <p>Cần hỗ trợ tra cứu hay sử dụng website? Hãy để lại lời nhắn cho thư viện.</p>
            </div>
            <div class="support-card">
                <div class="support-intro">
                    <small>CHÚNG TÔI CÓ THỂ GIÚP GÌ?</small>
                    <h3>Mọi hành trình đọc đều có thể bắt đầu bằng một câu hỏi.</h3>
                    <p>Tìm hiểu cách tra cứu tài liệu, đăng nhập tài khoản hoặc sử dụng các chức năng hiện có.</p>

                    <div class="support-point">
                        <b>01</b>
                        <span>
                            <strong>Tra cứu tài liệu</strong>
                            <small>Tìm sách theo tên, tác giả hoặc thể loại.</small>
                        </span>
                    </div>
                    <div class="support-point">
                        <b>02</b>
                        <span>
                            <strong>Tài khoản bạn đọc</strong>
                            <small>Hỗ trợ các vấn đề liên quan đến đăng nhập.</small>
                        </span>
                    </div>
                    <div class="support-point">
                        <b>03</b>
                        <span>
                            <strong>Hướng dẫn sử dụng</strong>
                            <small>Tìm hiểu các chức năng trên website.</small>
                        </span>
                    </div>
                </div>

                <form class="support-form" id="libraryRequestForm">
                    <small>GỬI THÔNG TIN</small>
                    <h3>Yêu cầu hỗ trợ</h3>

                    <label for="supportName">Họ và tên</label>
                    <input id="supportName" name="fullName" placeholder="Nhập họ và tên" required />

                    <label for="supportEmail">Địa chỉ email</label>
                    <input id="supportEmail" name="email" type="email" placeholder="you@example.com" required />

                    <label for="supportTopic">Chủ đề cần hỗ trợ</label>
                    <select id="supportTopic" name="topic" required>
                        <option value="">Chọn chủ đề</option>
                        <option>Tìm kiếm tài liệu</option>
                        <option>Tài khoản bạn đọc</option>
                        <option>Sách điện tử</option>
                        <option>Vấn đề khác</option>
                    </select>

                    <label for="supportMessage">Lời nhắn</label>
                    <textarea id="supportMessage" name="message" rows="4" placeholder="Bạn cần thư viện hỗ trợ điều gì?" required></textarea>

                    <button type="submit" class="btn-clay">Gửi yêu cầu <span>↗</span></button>
                    <p class="form-note" id="supportMessageStatus">Biểu mẫu giao diện minh họa, chưa kết nối chức năng gửi về máy chủ.</p>
                </form>
            </div>
        </section>

        <!-- 07. COLLECTION / MATERIAL LIBRARY -->
        <section class="sample-section collection-section" id="bo-suu-tap">
            <div class="section-heading">
                <p class="eyebrow">TỦ SÁCH THEO CHỦ ĐỀ</p>
                <h2>Tri thức từ nhiều miền.</h2>
                <p>Mỗi lĩnh vực là một cánh cửa khác nhau để bạn bước vào thế giới kiến thức.</p>
            </div>

            <div class="collection-tabs" aria-label="Chủ đề sách">
                <a href="#kham-pha" class="tab-active">Văn học</a>
                <a href="#kham-pha">Công nghệ</a>
                <a href="#kham-pha">Khoa học</a>
                <a href="#kham-pha">Kinh tế</a>
            </div>

            <div class="collection-feature">
                <div class="collection-icon">✦</div>
                <div>
                    <small>GỢI Ý KHÁM PHÁ</small>
                    <h3>Đọc để hiểu thêm về thế giới.</h3>
                    <p>Từ những câu chuyện nuôi dưỡng cảm xúc đến các tài liệu mở rộng kiến thức. Hãy chọn chủ đề phù hợp với điều bạn đang muốn tìm hiểu.</p>
                    <div class="collection-tags">
                        <span>Văn học</span>
                        <span>Kỹ năng</span>
                        <span>Kiến thức</span>
                    </div>
                </div>
            </div>
            <p class="sample-caption">Các nhóm chủ đề trên là nội dung giới thiệu giao diện; danh mục thực tế có thể được kết nối từ cơ sở dữ liệu sau.</p>
        </section>

        <!-- 08. PROJECT GRID -> EXPLORE -->
        <section class="sample-section explore-section" id="kham-pha">
            <div class="section-heading">
                <p class="eyebrow">KHÁM PHÁ KHO SÁCH</p>
                <h2>Chọn một cuốn, mở một thế giới.</h2>
                <p>Tìm kiếm những cuốn sách phù hợp với sở thích và nhu cầu học tập của bạn.</p>
            </div>

            <div class="explore-filters">
                <span class="filter-active">Tất cả</span>
                <span>Văn học</span>
                <span>Kỹ năng</span>
                <span>Công nghệ</span>
                <span>Khoa học</span>
            </div>

            <div class="explore-grid">
                <article class="explore-card explore-wide">
                    <div class="explore-cover cover-library">
                        <span>THƯ VIỆN SỐ</span>
                        <b>THE<br />READING<br />ROOM</b>
                    </div>
                    <div class="explore-info">
                        <small>KHÔNG GIAN ĐỌC</small>
                        <h3>Một thế giới đang chờ bạn.</h3>
                        <p>Khám phá các đầu sách đang được giới thiệu trong thư viện.</p>
                    </div>
                </article>

                <article class="explore-card">
                    <div class="explore-cover cover-clay">
                        <span>01 · FICTION</span>
                        <b>Stories<br />to keep</b>
                    </div>
                    <div class="explore-info">
                        <small>VĂN HỌC</small>
                        <h3>Những câu chuyện</h3>
                        <p>Đọc để cảm nhận và đồng hành cùng nhân vật.</p>
                    </div>
                </article>

                <article class="explore-card">
                    <div class="explore-cover cover-olive">
                        <span>02 · LEARNING</span>
                        <b>Learn<br />something</b>
                    </div>
                    <div class="explore-info">
                        <small>KỸ NĂNG</small>
                        <h3>Học hỏi mỗi ngày</h3>
                        <p>Mở rộng kiến thức và phát triển bản thân.</p>
                    </div>
                </article>

                <article class="explore-card">
                    <div class="explore-cover cover-sand">
                        <span>03 · KNOWLEDGE</span>
                        <b>Ideas<br />& beyond</b>
                    </div>
                    <div class="explore-info">
                        <small>KHOA HỌC</small>
                        <h3>Ý tưởng và khám phá</h3>
                        <p>Tìm hiểu những điều mới mẻ quanh ta.</p>
                    </div>
                </article>

                <article class="explore-card">
                    <div class="explore-cover cover-ink">
                        <span>04 · TECHNOLOGY</span>
                        <b>Future<br />in pages</b>
                    </div>
                    <div class="explore-info">
                        <small>CÔNG NGHỆ</small>
                        <h3>Thế giới số</h3>
                        <p>Tiếp cận kiến thức công nghệ và đổi mới.</p>
                    </div>
                </article>
            </div>

            <div class="center-action">
                <a asp-controller="Home" asp-action="DanhSachSach" class="btn-clay">Xem toàn bộ danh sách sách ↗</a>
            </div>
        </section>

        <!-- 09. MARKS & LABELS -->
        <section class="sample-section labels-section">
            <div class="section-heading">
                <p class="eyebrow">NHÃN & TRẠNG THÁI</p>
                <h2>Những dấu hiệu nhỏ, hữu ích.</h2>
                <p>Nhãn giúp bạn nhận biết nhanh nhóm nội dung và trạng thái hiển thị.</p>
            </div>

            <div class="label-board">
                <div>
                    <small>THỂ LOẠI</small>
                    <p>
                        <span class="tag tag-clay">Văn học</span>
                        <span class="tag tag-olive">Khoa học</span>
                        <span class="tag tag-sand">Kỹ năng</span>
                        <span class="tag tag-outline">Công nghệ</span>
                        <span class="tag tag-dark">Nổi bật</span>
                    </p>
                </div>
                <div>
                    <small>TRẠNG THÁI MINH HỌA</small>
                    <p>
                        <span class="tag tag-olive">● Đang hoạt động</span>
                        <span class="tag tag-clay">● Đang cập nhật</span>
                        <span class="tag tag-sand">● Lưu trữ</span>
                        <span class="tag tag-outline">● Sắp ra mắt</span>
                    </p>
                </div>
            </div>
        </section>

        <!-- 10. PROCESS -->
        <section class="sample-section process-section" id="quy-trinh">
            <div class="section-heading">
                <p class="eyebrow">HÀNH TRÌNH BẠN ĐỌC</p>
                <h2>Từ tìm kiếm đến khám phá.</h2>
                <p>Các bước cơ bản để bắt đầu sử dụng website thư viện.</p>
            </div>

            <div class="process-steps">
                <article class="process-card">
                    <span>1.</span>
                    <small>BƯỚC 01</small>
                    <h3>Tìm kiếm</h3>
                    <p>Nhập tên sách, tác giả hoặc từ khóa bạn quan tâm.</p>
                </article>
                <article class="process-card process-current">
                    <span>2.</span>
                    <small>BƯỚC 02</small>
                    <h3>Khám phá</h3>
                    <p>Xem thông tin và tìm hiểu những tài liệu phù hợp.</p>
                </article>
                <article class="process-card">
                    <span>3.</span>
                    <small>BƯỚC 03</small>
                    <h3>Đăng nhập</h3>
                    <p>Truy cập tài khoản để sử dụng chức năng được cấp quyền.</p>
                </article>
                <article class="process-card">
                    <span>4.</span>
                    <small>BƯỚC 04</small>
                    <h3>Tiếp tục đọc</h3>
                    <p>Sử dụng các tiện ích thư viện hiện có theo hướng dẫn.</p>
                </article>
            </div>

            <div class="process-detail">
                <div class="detail-top">
                    <strong>Bước 02 · Khám phá</strong>
                    <span>Hành trình bạn đọc</span>
                </div>
                <div class="progress-line"><span style="width:72%"></span></div>

                <div class="progress-row"><span>Tìm kiếm tài liệu</span><b>01</b></div>
                <div class="progress-line thin"><span style="width:100%"></span></div>

                <div class="progress-row"><span>Đọc thông tin sách</span><b>02</b></div>
                <div class="progress-line thin"><span style="width:72%"></span></div>

                <div class="progress-row"><span>Đăng nhập tài khoản</span><b>03</b></div>
                <div class="progress-line thin"><span style="width:42%"></span></div>

                <p class="sample-caption">Các bước mô tả quy trình sử dụng giao diện, không phải tiến độ tài khoản thực tế.</p>
            </div>
        </section>

        <!-- 11. NOTICES -->
        <section class="sample-section notices-section">
            <div class="section-heading">
                <p class="eyebrow">THÔNG TIN THƯ VIỆN</p>
                <h2>Những thông báo cần biết.</h2>
                <p>Một số nhắc nhở hữu ích trong quá trình sử dụng hệ thống.</p>
            </div>

            <div class="notice-list">
                <div class="notice notice-neutral">
                    <b>i</b>
                    <p>
                        <strong>Lưu ý tài khoản</strong>
                        <span>Hãy bảo mật thông tin đăng nhập và không chia sẻ mật khẩu.</span>
                    </p>
                </div>
                <div class="notice notice-success">
                    <b>✓</b>
                    <p>
                        <strong>Tra cứu thuận tiện</strong>
                        <span>Bạn có thể tìm sách theo tiêu đề hoặc thông tin tác giả ở trang danh sách sách.</span>
                    </p>

@{
    ViewData["Title"] = "Trang chủ";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<div class="library-home" >

    <!-- HEADER -->
    <header class="library-nav">
        <a asp-controller="Home" asp-action="Index" class="library-brand">
            <span class="brand-symbol">B.</span>
            <span class="brand-name">THƯ VIỆN SỐ</span>
        </a>

        <nav class="library-nav-links" aria-label="Điều hướng chính">
            <a href="#trang-chu" class="active">Trang chủ</a>
            <a href="#gioi-thieu">Giới thiệu</a>
            <a href="#bo-suu-tap">Bộ sưu tập</a>
            <a href="#kham-pha">Khám phá</a>
            <a href="#quy-trinh">Quy trình</a>
            <a href="#faq">Hỏi đáp</a>
        </nav>

        <a asp-controller="Account" asp-action="Login" class="nav-account">
            Đăng nhập <i class="bi bi-arrow-up-right"></i>
        </a>
    </header>

    <main>
        <!-- HERO -->
        <section class="lib-hero" id="trang-chu">
            <div class="hero-copy" data-aos="fade-up">
                <p class="eyebrow">
                    <span class="eyebrow-dot"></span>
                    KHÔNG GIAN TRI THỨC · 2026
                </p>

                <h1>
                    Mở từng trang sách,
                    chạm đến thế giới.
                </h1>

                <p class="hero-lead">
                    Một không gian đọc gần gũi, nơi bạn có thể tìm kiếm tài liệu,
                    khám phá những chủ đề mới và nuôi dưỡng niềm yêu thích học hỏi.
                </p>

                <div class="hero-actions">
                    <a asp-area="DocGia"
                       asp-controller="Home"
                       asp-action="Index"
                       class="btn-clay">
                        Khám phá sách
                        <i class="bi bi-arrow-up-right"></i>
                    </a>

                    <a href="#bo-suu-tap" class="btn-paper">
                        Về thư viện
                    </a>
                </div>

                <div class="hero-meta">
                    <span><i class="bi bi-check-circle"></i> Đọc mỗi ngày</span>
                    <span><i class="bi bi-check-circle"></i> Học điều mới</span>
                    <span><i class="bi bi-check-circle"></i> Mở rộng góc nhìn</span>
                </div>
            </div>

            <div class="hero-art" data-aos="fade-left" data-aos-delay="150">
                <img src="https://images.unsplash.com/photo-1507842217343-583bb7270b66?auto=format&fit=crop&w=1200&q=85"
                     alt="Không gian thư viện với những kệ sách"
                     fetchpriority="high" />

                <div class="hero-image-note">
                    <span>GÓC ĐỌC CỦA BẠN</span>
                    <strong>Find a quiet place. Open a new world.</strong>
                </div>

                <span class="hero-stamp">READ<br />MORE</span>
                <span class="hero-art-decoration">✳</span>
            </div>
        </section>

        <!-- INTRO / BUTTON SHOWCASE -->
        <section class="sample-section intro-section" id="gioi-thieu">
            <div class="section-heading" data-aos="fade-up">
                <p class="eyebrow">MỘT KHÔNG GIAN ĐỂ KHÁM PHÁ</p>
                <h2>Tri thức bắt đầu từ <em>một lựa chọn nhỏ.</em></h2>
                <p>
                    Tìm một cuốn sách, đọc một chủ đề mới và để mỗi ngày
                    trở thành một cơ hội học hỏi.
                </p>
            </div>

            <div class="button-showcase" data-aos="fade-up">
                <a asp-area="DocGia" asp-controller="Home" asp-action="Index"
                   class="btn-clay">Khám phá sách</a>

                <a asp-controller="Account" asp-action="Login"
                   class="btn-olive">Đăng nhập</a>

                <a href="#bo-suu-tap" class="btn-paper">Bộ sưu tập</a>

                <a href="#quy-trinh" class="btn-outline">Cách sử dụng</a>
            </div>
        </section>

        <!-- COLLECTION -->
        <section class="sample-section collection-section" id="bo-suu-tap">
            <div class="section-heading" data-aos="fade-up">
                <p class="eyebrow">TỦ SÁCH THEO CHỦ ĐỀ</p>
                <h2>Tri thức từ <em>nhiều miền.</em></h2>
                <p>
                    Mỗi lĩnh vực là một cánh cửa khác nhau để bạn bước vào
                    thế giới kiến thức.
                </p>
            </div>

            <div class="collection-tabs" data-aos="fade-up">
                <a href="#kham-pha" class="tab-active">Văn học</a>
                <a href="#kham-pha">Công nghệ</a>
                <a href="#kham-pha">Khoa học</a>
                <a href="#kham-pha">Kinh tế</a>
            </div>

            <div class="collection-feature" data-aos="fade-up">
                <div class="collection-icon">
                    <i class="bi bi-stars"></i>
                </div>

                <div class="collection-content">
                    <small>GỢI Ý KHÁM PHÁ</small>
                    <h3>Đọc để hiểu thêm về thế giới.</h3>
                    <p>
                        Từ những câu chuyện nuôi dưỡng cảm xúc đến các tài liệu
                        mở rộng kiến thức. Hãy chọn chủ đề phù hợp với điều bạn muốn tìm hiểu.
                    </p>

                    <div class="collection-tags">
                        <span>Văn học</span>
                        <span>Kỹ năng</span>
                        <span>Kiến thức</span>
                    </div>
                </div>
            </div>

            <p class="sample-caption">
                Các nhóm chủ đề trên là nội dung giới thiệu giao diện;
                danh mục thực tế có thể được kết nối từ cơ sở dữ liệu sau.
            </p>
        </section>

        <!-- EXPLORE -->
        <section class="sample-section explore-section" id="kham-pha">
            <div class="section-heading" data-aos="fade-up">
                <p class="eyebrow">KHÁM PHÁ KHO SÁCH</p>
                <h2>Chọn một cuốn, <em>mở một thế giới.</em></h2>
                <p>
                    Tìm kiếm những cuốn sách phù hợp với sở thích
                    và nhu cầu học tập của bạn.
                </p>
            </div>

            <div class="explore-filters" data-aos="fade-up">
                <span class="filter-active">Tất cả</span>
                <span>Văn học</span>
                <span>Kỹ năng</span>
                <span>Công nghệ</span>
                <span>Khoa học</span>
            </div>

            <div class="explore-grid">
                <article class="explore-card explore-wide" data-aos="fade-up">
                    <div class="explore-cover cover-library">
                        <span>THƯ VIỆN SỐ</span>
                        <b>THE READING ROOM</b>
                        <i class="bi bi-book-half"></i>
                    </div>
                    <div class="explore-info">
                        <small>KHÔNG GIAN ĐỌC</small>
                        <h3>Một thế giới đang chờ bạn.</h3>
                        <p>Khám phá các đầu sách đang được giới thiệu trong thư viện.</p>
                    </div>
                </article>

                <article class="explore-card" data-aos="fade-up" data-aos-delay="80">
                    <div class="explore-cover cover-clay">
                        <span>01 · FICTION</span>
                        <b>Stories to keep</b>
                        <i class="bi bi-book"></i>
                    </div>
                    <div class="explore-info">
                        <small>VĂN HỌC</small>
                        <h3>Những câu chuyện</h3>
                        <p>Đọc để cảm nhận và đồng hành cùng nhân vật.</p>
                    </div>
                </article>

                <article class="explore-card" data-aos="fade-up" data-aos-delay="140">
                    <div class="explore-cover cover-olive">
                        <span>02 · LEARNING</span>
                        <b>Learn something</b>
                        <i class="bi bi-lightbulb"></i>
                    </div>
                    <div class="explore-info">
                        <small>KỸ NĂNG</small>
                        <h3>Học hỏi mỗi ngày</h3>
                        <p>Mở rộng kiến thức và phát triển bản thân.</p>
                    </div>
                </article>

                <article class="explore-card" data-aos="fade-up" data-aos-delay="80">
                    <div class="explore-cover cover-sand">
                        <span>03 · KNOWLEDGE</span>
                        <b>Ideas & beyond</b>
                        <i class="bi bi-brightness-high"></i>
                    </div>
                    <div class="explore-info">
                        <small>KHOA HỌC</small>
                        <h3>Ý tưởng và khám phá</h3>
                        <p>Tìm hiểu những điều mới mẻ quanh ta.</p>
                    </div>
                </article>

                <article class="explore-card" data-aos="fade-up" data-aos-delay="140">
                    <div class="explore-cover cover-ink">
                        <span>04 · TECHNOLOGY</span>
                        <b>Future in pages</b>
                        <i class="bi bi-cpu"></i>
                    </div>
                    <div class="explore-info">
                        <small>CÔNG NGHỆ</small>
                        <h3>Thế giới số</h3>
                        <p>Tiếp cận kiến thức công nghệ và đổi mới.</p>
                    </div>
                </article>
            </div>

            <div class="center-action" data-aos="fade-up">
                <a asp-controller="Home" asp-action="DanhSachSach" class="btn-clay">
                    Xem toàn bộ danh sách sách
                    <i class="bi bi-arrow-up-right"></i>
                </a>
            </div>
        </section>

        <!-- PROCESS -->
        <section class="sample-section process-section" id="quy-trinh">
            <div class="section-heading" data-aos="fade-up">
                <p class="eyebrow">HÀNH TRÌNH BẠN ĐỌC</p>
                <h2>Từ tìm kiếm <em>đến khám phá.</em></h2>
                <p>Các bước cơ bản để bắt đầu sử dụng website thư viện.</p>
            </div>

            <div class="process-steps">
                <article class="process-card" data-aos="fade-up">
                    <span class="process-number">01</span>
                    <small>BƯỚC 01</small>
                    <h3>Tìm kiếm</h3>
                    <p>Nhập tên sách, tác giả hoặc từ khóa bạn quan tâm.</p>
                </article>

                <article class="process-card process-current" data-aos="fade-up" data-aos-delay="80">
                    <span class="process-number">02</span>
                    <small>BƯỚC 02</small>
                    <h3>Khám phá</h3>
                    <p>Xem thông tin và tìm hiểu những tài liệu phù hợp.</p>
                </article>

                <article class="process-card" data-aos="fade-up" data-aos-delay="160">
                    <span class="process-number">03</span>
                    <small>BƯỚC 03</small>
                    <h3>Đăng nhập</h3>
                    <p>Truy cập tài khoản để sử dụng chức năng được cấp quyền.</p>
                </article>

                <article class="process-card" data-aos="fade-up" data-aos-delay="240">
                    <span class="process-number">04</span>
                    <small>BƯỚC 04</small>
                    <h3>Tiếp tục đọc</h3>
                    <p>Sử dụng các tiện ích thư viện hiện có theo hướng dẫn.</p>
                </article>
            </div>

            <div class="process-detail" data-aos="fade-up">
                <div class="detail-top">
                    <strong>Bước 02 · Khám phá</strong>
                    <span>Hành trình bạn đọc</span>
                </div>

                <div class="progress-line"><span style="width:72%"></span></div>

                <div class="progress-row"><span>Tìm kiếm tài liệu</span><b>01</b></div>
                <div class="progress-line thin"><span style="width:100%"></span></div>

                <div class="progress-row"><span>Đọc thông tin sách</span><b>02</b></div>
                <div class="progress-line thin"><span style="width:72%"></span></div>

                <div class="progress-row"><span>Đăng nhập tài khoản</span><b>03</b></div>
                <div class="progress-line thin"><span style="width:42%"></span></div>

                <p class="sample-caption">
                    Các bước mô tả quy trình sử dụng giao diện,
                    không phải tiến độ tài khoản thực tế.
                </p>
            </div>
        </section>

        <!-- SUPPORT -->
        <section class="sample-section support-section" id="ho-tro">
            <div class="section-heading" data-aos="fade-up">
                <p class="eyebrow">KẾT NỐI VỚI THƯ VIỆN</p>
                <h2>Bắt đầu một <em>cuộc trò chuyện.</em></h2>
                <p>Cần hỗ trợ tra cứu hay sử dụng website? Hãy để lại lời nhắn cho thư viện.</p>
            </div>

            <div class="support-card" data-aos="fade-up">
                <div class="support-intro">
                    <small>CHÚNG TÔI CÓ THỂ GIÚP GÌ?</small>
                    <h3>Mọi hành trình đọc đều có thể bắt đầu bằng một câu hỏi.</h3>
                    <p>
                        Tìm hiểu cách tra cứu tài liệu, đăng nhập tài khoản
                        và sử dụng các chức năng hiện có.
                    </p>

                    <div class="support-point">
                        <b>01</b>
                        <span>
                            <strong>Tra cứu tài liệu</strong>
                            <small>Tìm sách theo tên, tác giả hoặc thể loại.</small>
                        </span>
                    </div>

                    <div class="support-point">
                        <b>02</b>
                        <span>
                            <strong>Tài khoản bạn đọc</strong>
                            <small>Hỗ trợ các vấn đề liên quan đến đăng nhập.</small>
                        </span>
                    </div>

                    <div class="support-point">
                        <b>03</b>
                        <span>
                            <strong>Hướng dẫn sử dụng</strong>
                            <small>Tìm hiểu các chức năng trên website.</small>
                        </span>
                    </div>
                </div>

                <form id="libraryRequestForm"
                      class="support-form"
                      asp-controller="Home"
                      asp-action="GuiYeuCau"
                      method="post">

                    @Html.AntiForgeryToken()

                    @if (TempData["SupportStatus"] != null)
                    {
                        <p class="form-status">@TempData["SupportStatus"]</p>
                    }

                    <label for="supportName">Họ và tên</label>
                    <input id="supportName" name="HoTen" placeholder="Họ và tên" required />

                    <label for="supportEmail">Địa chỉ email</label>
                    <input id="supportEmail" type="email" name="Email"
                           placeholder="example@email.com" required />

                    <label for="supportSubject">Chủ đề</label>
                    <select id="supportSubject" name="ChuDe" required>
                        <option value="Tìm kiếm tài liệu">Tìm kiếm tài liệu</option>
                        <option value="Tài khoản bạn đọc">Tài khoản bạn đọc</option>
                        <option value="Hướng dẫn sử dụng">Hướng dẫn sử dụng</option>
                        <option value="Khác">Khác</option>
                    </select>

                    <label for="supportMessage">Lời nhắn</label>
                    <textarea id="supportMessage" name="LoiNhan"
                              placeholder="Bạn cần thư viện hỗ trợ điều gì?" required></textarea>

                    <button type="submit">
                        Gửi yêu cầu <i class="bi bi-arrow-up-right"></i>
                    </button>
                </form>
            </div>
        </section>

        <!-- NOTICES -->
        <section class="sample-section notices-section">
            <div class="section-heading" data-aos="fade-up">
                <p class="eyebrow">THÔNG TIN THƯ VIỆN</p>
                <h2>Những thông báo <em>cần biết.</em></h2>
                <p>Một số nhắc nhở hữu ích trong quá trình sử dụng hệ thống.</p>
            </div>

            <div class="notice-list">
                <div class="notice notice-neutral" data-aos="fade-up">
                    <b><i class="bi bi-info-lg"></i></b>
                    <p>
                        <strong>Lưu ý tài khoản</strong>
                        <span>Hãy bảo mật thông tin đăng nhập và không chia sẻ mật khẩu.</span>
                    </p>
                </div>

                <div class="notice notice-success" data-aos="fade-up" data-aos-delay="70">
                    <b><i class="bi bi-check-lg"></i></b>
                    <p>
                        <strong>Tra cứu thuận tiện</strong>
                        <span>Bạn có thể tìm sách theo tiêu đề hoặc thông tin tác giả ở trang danh sách sách.</span>
                    </p>
                </div>

                <div class="notice notice-warning" data-aos="fade-up" data-aos-delay="140">
                    <b><i class="bi bi-exclamation-lg"></i></b>
                    <p>
                        <strong>Thông tin đang cập nhật</strong>
                        <span>Một số nội dung giới thiệu trên trang chủ có thể được hoàn thiện theo tiến độ dự án.</span>
                    </p>
                </div>

                <div class="notice notice-clay" data-aos="fade-up" data-aos-delay="210">
                    <b><i class="bi bi-arrow-up-right"></i></b>
                    <p>
                        <strong>Truy cập đúng quyền</strong>
                        <span>Hãy sử dụng các chức năng phù hợp với tài khoản được cấp.</span>
                    </p>
                </div>
            </div>
        </section>

        <!-- CATALOG TABLE -->
        <section class="sample-section catalog-section">
            <div class="section-heading" data-aos="fade-up">
                <p class="eyebrow">SỔ TAY THƯ VIỆN</p>
                <h2>Thông tin được <em>sắp xếp rõ ràng.</em></h2>
                <p>Khu vực minh họa cách trình bày thông tin tài liệu trong một bảng dễ theo dõi.</p>
            </div>

            <div class="catalog-table-wrap" data-aos="fade-up">
                <div class="table-responsive">
                    <table class="catalog-table">
                        <thead>
                            <tr>
                                <th>TÀI LIỆU</th>
                                <th>NHÓM CHỦ ĐỀ</th>
                                <th>THÔNG TIN</th>
                                <th>TRẠNG THÁI</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><strong>Văn học & câu chuyện</strong><small>Nhóm nội dung giới thiệu</small></td>
                                <td>Văn học</td>
                                <td>Khám phá</td>
                                <td><span class="table-status">Đang giới thiệu</span></td>
                            </tr>
                            <tr>
                                <td><strong>Kỹ năng & phát triển</strong><small>Nhóm nội dung giới thiệu</small></td>
                                <td>Kỹ năng</td>
                                <td>Học tập</td>
                                <td><span class="table-status">Đang giới thiệu</span></td>
                            </tr>
                            <tr>
                                <td><strong>Khoa học thường thức</strong><small>Nhóm nội dung giới thiệu</small></td>
                                <td>Khoa học</td>
                                <td>Kiến thức</td>
                                <td><span class="table-status">Đang giới thiệu</span></td>
                            </tr>
                            <tr>
                                <td><strong>Công nghệ số</strong><small>Nhóm nội dung giới thiệu</small></td>
                                <td>Công nghệ</td>
                                <td>Nghiên cứu</td>
                                <td><span class="table-status status-muted">Đang cập nhật</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="table-footer">
                    <span>Bảng minh họa giao diện · Không phải dữ liệu mượn trả thực tế</span>
                    <a asp-area="DocGia" asp-controller="Home" asp-action="Index">
                        Đến danh sách sách <i class="bi bi-arrow-up-right"></i>
                    </a>
                </div>
            </div>
        </section>

        <!-- RULES -->
        <section class="sample-section rules-section">
            <div class="section-heading" data-aos="fade-up">
                <p class="eyebrow">NGUYÊN TẮC THƯ VIỆN</p>
                <h2>Đọc có trách nhiệm, <em>chia sẻ văn minh.</em></h2>
                <p>Một vài nguyên tắc cơ bản để cùng xây dựng môi trường học tập tích cực.</p>
            </div>

            <div class="rules-grid">
                <article class="rules-card rules-do" data-aos="fade-up">
                    <h3><span>✓</span> NÊN LÀM</h3>
                    <ul>
                        <li>Tra cứu bằng thông tin sách chính xác.</li>
                        <li>Bảo vệ tài khoản và mật khẩu cá nhân.</li>
                        <li>Tôn trọng quyền sở hữu trí tuệ.</li>
                        <li>Sử dụng tài liệu đúng phạm vi được phép.</li>
                        <li>Liên hệ hỗ trợ khi gặp vấn đề.</li>
                    </ul>
                </article>

                <article class="rules-card rules-dont" data-aos="fade-up" data-aos-delay="100">
                    <h3><span>×</span> CẦN TRÁNH</h3>
                    <ul>
                        <li>Chia sẻ tài khoản tùy tiện.</li>
                        <li>Sao chép hoặc phát tán tài liệu trái phép.</li>
                        <li>Cung cấp thông tin đăng ký sai lệch.</li>
                        <li>Truy cập chức năng ngoài quyền được cấp.</li>
                        <li>Sử dụng hệ thống sai mục đích.</li>

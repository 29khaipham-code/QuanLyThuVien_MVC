@model QuanLyThuVien.ViewModels.Admin.TongQuan.DashboardThongKeViewModel

@{
    ViewData["Title"] = "Trang tổng quan Thủ thư";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
<h3 class="mb-2">Xin chào, @User.Identity?.Name!</h3>

<p class="text-muted mb-4">
    Chào mừng đến với hệ thống quản lý thư viện.
</p>

<div class="row g-3">

    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon">📚</div>
            <h6>Tổng đầu sách</h6>
            <p class="text-muted small mb-0">
                @ViewBag.TongDauSach đầu sách trong thư viện
            </p>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon">👥</div>
            <h6>Tổng độc giả</h6>
            <p class="text-muted small mb-0">
                @ViewBag.TongDocGia độc giả đã đăng ký
            </p>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon">🔄</div>
            <h6>Sách đang mượn</h6>
            <p class="text-muted small mb-0">
                @ViewBag.SachDangMuon cuốn chưa được trả
            </p>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon">⚠️</div>
            <h6>Mượn quá hạn</h6>
            <p class="text-muted small mb-0">
                @ViewBag.SachQuaHan cuốn đã quá hạn trả
            </p>
        </div>
    </div>

</div>

<div class="content-card mt-4">
    <h5>Nghiệp vụ thư viện</h5>
    <p class="text-muted">
        Chọn một chức năng để bắt đầu quản lý.
    </p>

    <div class="row g-3">

            <div class="col-md-6 col-xl-4">
                <a class="btn btn-outline-primary w-100 py-3"
                   asp-area="Admin"
                   asp-controller="SachAdmin"
                   asp-action="Index">
                    📚 Quản lý sách
                </a>
            </div>

                <div class="col-md-6 col-xl-4">
                    <a class="btn btn-outline-primary w-100 py-3"
                       asp-area="Admin" asp-controller="BanSaoSach" asp-action="Index">
                        📖 Quản lý bản sao sách
                    </a>
                </div>
                <div class="col-md-6 col-xl-4">
                    <a class="btn btn-outline-primary w-100 py-3"
                       asp-area="Admin" asp-controller="DocGia" asp-action="Index">
                        🪪 Quản lý độc giả
                    </a>
                </div>
                <div class="col-md-6 col-xl-4">
                    <a class="btn btn-outline-primary w-100 py-3"
                       asp-area="Admin" asp-controller="MuonTra" asp-action="Index">
                        🔄 Mượn / Trả sách
                    </a>
                </div>
                <div class="col-md-6 col-xl-4">
                    <a class="btn btn-outline-primary w-100 py-3"
                       asp-area="Admin" asp-controller="DatTruoc" asp-action="Index">
                        📌 Đặt trước sách
                    </a>
                </div>
                <div class="col-md-6 col-xl-4">
                    <a class="btn btn-outline-primary w-100 py-3"
                       asp-area="Admin" asp-controller="Phat" asp-action="Index">
                        💰 Quản lý tiền phạt
                    </a>
                </div>
        </div>
    </div>
</div>

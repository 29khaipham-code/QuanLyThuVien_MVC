
@model QuanLyThuVien.ViewModels.Sach.SachFormViewModel

@{
    ViewData["Title"] = "Sửa sách";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <h3 class="mb-4">Chỉnh sửa sách #@Model.Id</h3>

    <div class="card">
        <div class="card-body p-4">

            <form asp-area="Admin"
                  asp-controller="Sach"
                  asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <input asp-for="Id" type="hidden" />

                @await Html.PartialAsync(
                    "~/Areas/Admin/Views/Sach/_Form.cshtml",
                    Model
                )

                <div class="mt-4 d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary">
                        Lưu thay đổi
                    </button>

                    <a asp-area="Admin"
                       asp-controller="Sach"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Quay lại
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>


@model QuanLyThuVien.ViewModels.BanSaoSach.BanSaoSachFormViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    var sachOptions =
        ViewBag.SachOptions as IEnumerable<SelectListItem>;
}

<div asp-validation-summary="ModelOnly"
     class="text-danger mb-3"></div>

<div class="row g-3">
    <div class="col-md-12">
        <label asp-for="SachId" class="form-label"></label>

        <select asp-for="SachId"
                asp-items="sachOptions"
                class="form-select">
            <option value="0">-- Chọn đầu sách --</option>
        </select>

        <span asp-validation-for="SachId"
              class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="MaVach" class="form-label"></label>
        <input asp-for="MaVach" class="form-control"
               placeholder="VD: BS0001" />
        <span asp-validation-for="MaVach"
              class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="ViTri" class="form-label"></label>
        <input asp-for="ViTri" class="form-control"
               placeholder="VD: Kệ A3 - Tầng 2" />
        <span asp-validation-for="ViTri"
              class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="TrangThai" class="form-label"></label>
        <select asp-for="TrangThai" class="form-select">
            <option value="SanSang">Sẵn sàng</option>
            <option value="HuHong">Hư hỏng</option>
            <option value="DangSua">Đang sửa</option>
        </select>
        <span asp-validation-for="TrangThai"
              class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="TinhTrang" class="form-label"></label>
        <select asp-for="TinhTrang" class="form-select">
            <option value="Moi">Mới</option>
            <option value="Tot">Tốt</option>
            <option value="Cu">Cũ</option>
            <option value="HuHong">Hư hỏng</option>
        </select>
        <span asp-validation-for="TinhTrang"
              class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="NgayNhap" class="form-label"></label>
        <input asp-for="NgayNhap" type="date"
               class="form-control"
               asp-format="{0:yyyy-MM-dd}" />
        <span asp-validation-for="NgayNhap"
              class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="GiaTri" class="form-label"></label>
        <input asp-for="GiaTri" type="number" min="0"
               step="0.01" class="form-control"
               placeholder="VD: 150000" />
        <span asp-validation-for="GiaTri"
              class="text-danger"></span>
    </div>
</div>


@model QuanLyThuVien.ViewModels.DatTruoc.DatTruocFormViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Tạo yêu cầu đặt trước";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var docGiaOptions =
        ViewBag.DocGiaOptions as IEnumerable<SelectListItem>;

    var sachOptions =
        ViewBag.SachOptions as IEnumerable<SelectListItem>;
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <h3 class="fw-bold">Tạo yêu cầu đặt trước sách</h3>
        <p class="text-secondary">
            Chọn độc giả và đầu sách muốn đặt trước
        </p>
    </div>

    <div class="card">
        <div class="card-body p-4">

            <form method="post"
                  action="@Url.Action("Create", "DatTruoc", new { area = "Admin" })">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="All"
                     class="text-danger mb-3"></div>

                <div class="mb-4">
                    <label asp-for="DocGiaId"
                           class="form-label fw-semibold">
                        Độc giả
                    </label>

                    <select asp-for="DocGiaId"
                            asp-items="docGiaOptions"
                            class="form-select">

                        <option value="0">
                            -- Chọn độc giả --
                        </option>
                    </select>

                    <span asp-validation-for="DocGiaId"
                          class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="SachId"
                           class="form-label fw-semibold">
                        Sách muốn đặt trước
                    </label>

                    <select asp-for="SachId"
                            asp-items="sachOptions"
                            class="form-select">

                        <option value="0">
                            -- Chọn sách --
                        </option>
                    </select>

                    <span asp-validation-for="SachId"
                          class="text-danger"></span>
                </div>

                <div class="alert alert-info">
                    Khi tạo yêu cầu, trạng thái sẽ là
                    <strong>Đang chờ</strong>.

                    Nhân viên có thể giữ một bản sao khi có sách
                    sẵn sàng. Thời gian giữ mặc định là 3 ngày.
                </div>

                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary">
                        Xác nhận đặt trước
                    </button>

                    <a href="@Url.Action("Index", "DatTruoc", new { area = "Admin" })"
                       class="btn btn-outline-secondary">
                        Quay lại
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

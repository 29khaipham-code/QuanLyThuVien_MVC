
@model List<QuanLyThuVien.ViewModels.DatTruoc.DatTruocListItemViewModel>

@{
    ViewData["Title"] = "Quản lý đặt trước";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    string keyword = ViewBag.Keyword as string ?? "";
    string trangThai = ViewBag.TrangThai as string ?? "";
    int page = ViewBag.Page ?? 1;
    int totalPages = ViewBag.TotalPages ?? 0;
    int total = ViewBag.Total ?? 0;
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold">Quản lý đặt trước sách</h3>
            <p class="text-secondary mb-0">
                Theo dõi hàng chờ và tình trạng giữ sách
            </p>
        </div>

        <a class="btn btn-primary"
           href="@Url.Action("Create", "DatTruoc", new { area = "Admin" })">
            + Tạo yêu cầu
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <form method="get"
                  action="@Url.Action("Index", "DatTruoc", new { area = "Admin" })">

                <div class="row g-2">

                    <div class="col-md-6">
                        <input name="keyword"
                               value="@keyword"
                               class="form-control"
                               placeholder="Tên độc giả, mã độc giả, tên sách..." />
                    </div>

                    <div class="col-md-3">
                        <select name="trangThai" class="form-select">
                            <option value="">Tất cả trạng thái</option>

                            @foreach (var item in new[]
                            {
                                ("DangCho", "Đang chờ"),
                                ("DaGiu", "Đã giữ"),
                                ("DaNhan", "Đã nhận"),
                                ("QuaHan", "Quá hạn"),
                                ("Huy", "Đã hủy")
                            })
                            {
                                if (trangThai == item.Item1)
                                {
                                    <option value="@item.Item1" selected>
                                        @item.Item2
                                    </option>
                                }
                                else
                                {
                                    <option value="@item.Item1">
                                        @item.Item2
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit"
                                class="btn btn-primary flex-fill">
                            Tìm kiếm
                        </button>

                        <a href="@Url.Action("Index", "DatTruoc", new { area = "Admin" })"
                           class="btn btn-outline-secondary">
                            Đặt lại
                        </a>
                    </div>

                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-body">

            <p>
                Tổng số:
                <strong>@total</strong> yêu cầu
            </p>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Độc giả</th>
                            <th>Sách</th>
                            <th>Ngày đặt</th>
                            <th>Mã vạch giữ</th>
                            <th>Hạn giữ</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>

                                <td>
                                    <strong>@item.HoTen</strong>
                                    <div class="small text-secondary">
                                        @item.MaDocGia
                                    </div>
                                </td>

                                <td>@item.TenSach</td>

                                <td>
                                    @item.NgayDat.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>@(item.MaVach ?? "—")</td>

                                <td>
                                    @if (item.NgayHetHan.HasValue)
                                    {
                                        @item.NgayHetHan.Value.ToString("dd/MM/yyyy HH:mm")
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>

                                <td>
                                    @{
                                        string status = item.TrangThai switch
                                        {
                                            "DangCho" => "Đang chờ",
                                            "DaGiu" => "Đã giữ",
                                            "DaNhan" => "Đã nhận",
                                            "QuaHan" => "Quá hạn",
                                            "Huy" => "Đã hủy",
                                            _ => item.TrangThai
                                        };

                                        string badge = item.TrangThai switch
                                        {
                                            "DangCho" => "bg-warning text-dark",
                                            "DaGiu" => "bg-info text-dark",
                                            "DaNhan" => "bg-success",
                                            "QuaHan" => "bg-danger",
                                            _ => "bg-secondary"
                                        };
                                    }

                                    <span class="badge @badge">
                                        @status
                                    </span>
                                </td>

                                <td>
                                    <div class="d-flex gap-2 flex-wrap">

                                        @if (item.TrangThai == "DangCho")
                                        {
                                            <form method="post"
                                                  action="@Url.Action("Hold", "DatTruoc", new { area = "Admin", id = item.Id })"
                                                  onsubmit="return confirm('Giữ bản sao cho độc giả này?');">
                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-primary">
                                                    Giữ sách
                                                </button>
                                            </form>
                                        }

                                        @if (item.TrangThai == "DaGiu" &&
                                             item.NgayHetHan.HasValue &&
                                             item.NgayHetHan.Value <= DateTime.Now)
                                        {
                                            <form method="post"
                                                  action="@Url.Action("Expire", "DatTruoc", new { area = "Admin", id = item.Id })">
                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-warning">
                                                    Xử lý quá hạn
                                                </button>
                                            </form>
                                        }

                                        @if (item.TrangThai == "DangCho" ||
                                             item.TrangThai == "DaGiu")
                                        {
                                            <form method="post"
                                                  action="@Url.Action("Cancel", "DatTruoc", new { area = "Admin", id = item.Id })"
                                                  onsubmit="return confirm('Hủy yêu cầu đặt trước này?');">
                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    Hủy
                                                </button>
                                            </form>
                                        }

                                    </div>
                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8"
                                    class="text-center py-4">
                                    Chưa có yêu cầu đặt trước nào.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <nav class="mt-3">
                    <ul class="pagination justify-content-end">

                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == page ? "active" : "")">

                                <a class="page-link"
                                   href="@Url.Action("Index", "DatTruoc",
                                       new {
                                           area = "Admin",
                                           keyword = keyword,
                                           trangThai = trangThai,
                                           page = i
                                       })">
                                    @i
                                </a>
                            </li>
                        }

                    </ul>
                </nav>
            }

        </div>
    </div>
</div>

@{
    string pageTitle = ViewData["Title"]?.ToString()
        ?? "Quản trị thư viện";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@pageTitle - Quản lý thư viện</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/admin.css"
          asp-append-version="true" />
</head>

<body>
    <div class="admin-wrapper">

        <!-- MENU BÊN TRÁI -->
        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <aside class="admin-sidebar">
            <div class="sidebar-brand">
                <div class="brand-icon">📚</div>
                <h5>QUẢN LÝ THƯ VIỆN</h5>
                <small>Hệ thống quản trị</small>
            </div>

            <nav class="sidebar-menu">

                @if (User.IsInRole("QuanTri"))
                {
                    <!-- TỔNG QUAN ADMIN -->
                    <button type="button" class="menu-toggle" title="Tổng quan">
                        <span class="menu-icon">🏠</span>
                        <span class="menu-text">Tổng quan</span>
                        <span class="arrow">⌄</span>
                    </button>
                    <div class="submenu">
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                            Trang tổng quan
                        </a>
                    </div>

                    <!-- CHỨC NĂNG CHỈ ADMIN -->
                    <button type="button" class="menu-toggle" title="Quản lý hệ thống">
                        <span class="menu-icon">👥</span>
                        <span class="menu-text">Quản lý hệ thống</span>
                        <span class="arrow">⌄</span>
                    </button>
                    <div class="submenu">
                        <a asp-area="Admin" asp-controller="TaiKhoan" asp-action="Index">
                            Quản lý tài khoản
                        </a>
                    </div>

                    <button type="button" class="menu-toggle" title="Danh mục">
                        <span class="menu-icon">📁</span>
                        <span class="menu-text">Danh mục</span>
                        <span class="arrow">⌄</span>
                    </button>
                    <div class="submenu">
                        <a asp-area="Admin" asp-controller="TheLoai" asp-action="Index">
                            Quản lý thể loại
                        </a>
                        <a asp-area="Admin" asp-controller="TacGia" asp-action="Index">
                            Quản lý tác giả
                        </a>
                        <a asp-area="Admin" asp-controller="NhaXuatBan" asp-action="Index">
                            Nhà xuất bản
                        </a>
                    </div>
                }
                else if (User.IsInRole("ThuThu"))
                {
                    <button type="button" class="menu-toggle" title="Tổng quan">
                        <span class="menu-icon">🏠</span>
                        <span class="menu-text">Tổng quan</span>
                        <span class="arrow">⌄</span>
                    </button>
                    <div class="submenu">
                        <a asp-area="ThuThu" asp-controller="Home" asp-action="Index">
                            Trang tổng quan
                        </a>
                    </div>
                }

                <!-- NGHIỆP VỤ CHUNG: ADMIN VÀ THỦ THƯ -->
                <button type="button" class="menu-toggle" title="Quản lý thư viện">
                    <span class="menu-icon">📚</span>
                    <span class="menu-text">Quản lý thư viện</span>
                    <span class="arrow">⌄</span>
                </button>
                <div class="submenu">
                    <a asp-area="Admin" asp-controller="SachAdmin" asp-action="Index">
                        Quản lý sách
                    </a>
                    <a asp-area="Admin" asp-controller="BanSaoSach" asp-action="Index">
                        Quản lý bản sao sách
                    </a>
                    <a asp-area="Admin" asp-controller="DocGia" asp-action="Index">
                        Độc giả
                    </a>
                    <a asp-area="Admin" asp-controller="MuonTra" asp-action="Index">
                        Mượn / Trả sách
                    </a>
                    <a asp-area="Admin" asp-controller="DatTruoc" asp-action="Index">
                        Đặt trước sách
                    </a>
                    <a asp-area="Admin" asp-controller="Phat" asp-action="Index">
                        Tiền phạt
                    </a>
                </div>

                @if (User.IsInRole("QuanTri"))
                {
                    <button type="button" class="menu-toggle" title="Quản lý mở rộng">
                        <span class="menu-icon">💻</span>
                        <span class="menu-text">Quản lý mở rộng</span>
                        <span class="arrow">⌄</span>
                    </button>
                    <div class="submenu">
                        <a asp-area="Admin" asp-controller="SachDienTu" asp-action="Index">
                            Sách điện tử
                        </a>
                    </div>

                    <button type="button" class="menu-toggle" title="Báo cáo và thống kê">
                        <span class="menu-icon">📊</span>
                        <span class="menu-text">Báo cáo và thống kê</span>
                        <span class="arrow">⌄</span>
                    </button>
                    <div class="submenu">
                        <a asp-area="Admin"
                           asp-controller="Dashboard"
                           asp-action="Module"
                           asp-route-id="ThongKe">
                            Thống kê
                        </a>
                    </div>
                }

            </nav>
        </aside>

        <!-- NỘI DUNG BÊN PHẢI -->
        <div class="admin-main">

            <header class="admin-header">

                <!-- NÚT MỞ / ĐÓNG SIDEBAR -->
                <button type="button"
                        id="toggleSidebar"
                        class="btn btn-outline-secondary"
                        aria-label="Mở hoặc đóng menu">
                    ☰
                </button>

                <div style="
                    display: flex;
                    justify-content: flex-end;
                    align-items: center;
                    gap: 40px;
                    margin-left: auto;
                    width: 100%;">

                    <!-- NÚT VỀ TRANG CHỦ -->
                    <a asp-area=""
                       asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-outline-primary px-3">
                        🏠 Về trang chủ
                    </a>

                    <!-- NÚT ĐĂNG XUẤT -->
                    <form asp-area=""
                          asp-controller="Account"
                          asp-action="Logout"
                          method="post"
                          style="margin: 0;">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-outline-danger px-3">
                            🚪 Đăng xuất
                        </button>
                    </form>

                </div>
            </header>

            <main class="admin-content">
                @RenderBody()
            </main>

            <footer class="admin-footer">
                © 2026 - Hệ thống Quản lý thư viện
            </footer>

        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
            const sidebar = document.querySelector(".admin-sidebar");
            const toggleButton = document.getElementById("toggleSidebar");
            const overlay = document.getElementById("sidebarOverlay");

            // Mặc định thu nhỏ khi tải trang
            function closeSidebar() {
                sidebar.classList.remove("expanded");
                overlay?.classList.remove("show");

                if (toggleButton) {
                    toggleButton.textContent = "☰";
                }

                // Đóng tất cả nhóm menu
                document.querySelectorAll(".menu-toggle").forEach(item => {
                    item.classList.remove("active");
                });

                document.querySelectorAll(".submenu").forEach(item => {
                    item.classList.remove("show");
                });
            }

            // Mở Sidebar
            function openSidebar() {
                sidebar.classList.add("expanded");
                overlay?.classList.add("show");

                if (toggleButton) {
                    toggleButton.textContent = "×";
                }
            }

            // Nút mở rộng / thu nhỏ
            toggleButton?.addEventListener("click", function () {
                if (sidebar.classList.contains("expanded")) {
                    closeSidebar();
                } else {
                    openSidebar();
                }
            });

            // Bấm ra ngoài Sidebar
            overlay?.addEventListener("click", closeSidebar);

            // Xử lý 5 nhóm menu
            document.querySelectorAll(".menu-toggle").forEach(button => {

                button.addEventListener("click", function () {

                    const submenu = this.nextElementSibling;

                    // Nếu đang thu nhỏ thì mở Sidebar trước
                    if (!sidebar.classList.contains("expanded")) {

                        openSidebar();

                        // Đóng các nhóm khác
                        document.querySelectorAll(".menu-toggle").forEach(item => {
                            item.classList.remove("active");
                        });

                        document.querySelectorAll(".submenu").forEach(item => {
                            item.classList.remove("show");
                        });

                        // Mở nhóm vừa chọn
                        this.classList.add("active");
                        submenu.classList.add("show");

                        return;
                    }

                    // Nếu Sidebar đang mở rộng
                    const isOpen = submenu.classList.contains("show");

                    // Đóng tất cả nhóm
                    document.querySelectorAll(".menu-toggle").forEach(item => {
                        item.classList.remove("active");
                    });

                    document.querySelectorAll(".submenu").forEach(item => {
                        item.classList.remove("show");
                    });

                    // Nếu nhóm chưa mở thì mở nó
                    if (!isOpen) {
                        this.classList.add("active");
                        submenu.classList.add("show");
                    }
                });
            });

            // Chọn chức năng con
            document.querySelectorAll(".submenu a").forEach(link => {
                link.addEventListener("click", function () {
                    closeSidebar();
                });
            });

            // Khởi tạo trạng thái
            closeSidebar();
    </script>
</body>
</html>


@{
    string pageTitle = ViewData["Title"]?.ToString()
        ?? "Quản trị thư viện";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@pageTitle - Quản lý thư viện</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
     <link rel="stylesheet"
      href="~/css/admin.css"
      asp-append-version="true" />
      
     
</head>
<body>
    <div class="admin-wrapper">

        <!-- MENU BÊN TRÁI -->
        <aside class="admin-sidebar">
            <div class="sidebar-brand">
                <div class="brand-icon">📚</div>
                <h5>QUẢN LÝ THƯ VIỆN</h5>
                <small>Hệ thống quản trị</small>
            </div>

            <nav class="sidebar-menu">

                <div class="menu-heading">TỔNG QUAN</div>

                <a asp-area="Admin"
                   asp-controller="Dashboard"
                   asp-action="Index">
                    🏠 Trang tổng quan
                </a>

                <div class="menu-heading">QUẢN LÝ HỆ THỐNG</div>

                <a asp-area="Admin"
                   asp-controller="TaiKhoan"
                   asp-action="Index">
                    👥 Quản lý tài khoản
                </a>

                <div class="menu-heading">DANH MỤC</div>

                
                <a asp-area="Admin"
                   asp-controller="TheLoai"
                   asp-action="Index">
                    📁 Quản lý thể loại
                </a>


                
                <a asp-area="Admin"
                   asp-controller="TacGia"
                   asp-action="Index">
                    ✍️ Quản lý tác giả
                </a>


                <a asp-area="Admin"
                   asp-controller="NhaXuatBan"
                   asp-action="Index"
                   class="nav-link">
                    <i class="bi bi-building"></i>
                    Nhà xuất bản
                </a>

                <div class="menu-heading">QUẢN LÝ THƯ VIỆN</div>

                
                


                <a asp-area="Admin"
                   asp-controller="BanSaoSach"
                   asp-action="Index"
                   class="nav-link">
                    📚 Quản lý bản sao sách
                </a>

                <a asp-area="Admin"
                   asp-controller="DocGia"
                   asp-action="Index"
                   class="nav-link">
                    🪪 Độc giả
                </a>

                <a href="@Url.Action("Index", "MuonTra", new { area = "Admin" })"
                      class="nav-link">
                    🔄 Mượn / Trả sách
                </a>

                
                <a href="@Url.Action("Index", "DatTruoc", new { area = "Admin" })"
                   class="nav-link">
                    📌 Đặt trước sách
                </a>


                
                <a href="@Url.Action("Index", "Phat", new { area = "Admin" })"
                   class="nav-link">
                    💰 Tiền phạt
                </a>


              
                <a asp-area="Admin"
                   asp-controller="SachDienTu"
                   asp-action="Index"
                   class="nav-link">
                    💻 Sách điện tử
                </a>


                <a asp-area="Admin"
                   asp-controller="Dashboard"
                   asp-action="Module"
                   asp-route-id="ThongKe">
                    📊 Thống kê

                </a>
                <a href="@Url.Action("Index", "SachAdmin", new { area = "Admin" })"
                   class="nav-link">
                    📚 Quản Lý Sách
                </a>
            </nav>
        </aside>

        <!-- NỘI DUNG BÊN PHẢI -->
        <div class="admin-main">

            <header class="admin-header">

               
               
                <div style="display: flex;
                    justify-content: flex-end;
                    align-items: center;
                    gap: 40px;
                    margin-left: auto;
                    width: 100%;">

                    <!-- NÚT VỀ TRANG CHỦ -->
                    <a asp-area=""
                       asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-outline-primary px-3">
                        🏠 Về trang chủ
                    </a>

                    <!-- NÚT ĐĂNG XUẤT -->
                    <form asp-area=""
                          asp-controller="Account"
                          asp-action="Logout"
                          method="post"
                          style="margin: 0;">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-outline-danger px-3">
                            🚪 Đăng xuất
                        </button>
                    </form>

                </div>



            </header>

            <main class="admin-content">
                @RenderBody()
            </main>

            <footer class="admin-footer">
                © 2026 - Hệ thống Quản lý thư viện
            </footer>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js">
    </script>

    <script>
        document.getElementById("toggleSidebar")
            ?.addEventListener("click", function () {
                document.querySelector(".admin-sidebar")
                    ?.classList.toggle("show");
            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@model QuanLyThuVien.ViewModels.Admin.TongQuan.DashboardThongKeViewModel

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Trang tổng quan";
}

<h3 class="mb-2">Xin chào, @User.Identity?.Name!</h3>

<p class="text-muted mb-4">
    Chào mừng đến với hệ thống quản lý thư viện.
</p>

<div class="row g-3">

    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon">📚</div>
            <h6>Tổng đầu sách</h6>
            <p class="text-muted small mb-0">
                @Model.TongDauSach.ToString("N0") đầu sách trong thư viện
            </p>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon">👥</div>
            <h6>Tổng độc giả</h6>
            <p class="text-muted small mb-0">
                @Model.TongDocGia.ToString("N0") độc giả đã đăng ký
            </p>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon">🔄</div>
            <h6>Sách đang mượn</h6>
            <p class="text-muted small mb-0">
                @Model.SachDangMuon.ToString("N0") cuốn chưa được trả
            </p>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon">⚠️</div>
            <h6>Mượn quá hạn</h6>
            <p class="text-muted small mb-0">
                @Model.MuonQuaHan.ToString("N0") cuốn đã quá hạn trả
            </p>
        </div>
    </div>

</div>

<div class="content-card mt-4">
    <h5>Chức năng quản trị</h5>
    <p class="text-muted">
        Chọn một chức năng để bắt đầu quản lý.
    </p>

    <div class="row g-3">

        <div class="col-md-4">
            <a class="quick-link"
               asp-area="Admin"
               asp-controller="TaiKhoan"
               asp-action="Index">
                👥 Quản lý tài khoản
            </a>
        </div>

        <div class="col-md-4">
            <a class="quick-link"
               asp-area="Admin"
               asp-controller="SachAdmin"
               asp-action="Index">
                📚 Quản lý sách
            </a>
        </div>

        <div class="col-md-4">
            <a class="quick-link"
               asp-area="Admin"
               asp-controller="DocGia"
               asp-action="Index">
                🪪 Quản lý độc giả
            </a>
        </div>

        <div class="col-md-4">
            <a class="quick-link"
               asp-area="Admin"
               asp-controller="MuonTra"
               asp-action="Index">
                🔄 Mượn / Trả
            </a>
        </div>

        <div class="col-md-4">
            <a class="quick-link"
               asp-area="Admin"
               asp-controller="SachDienTu"
               asp-action="Index">
                💻 Sách điện tử
            </a>
        </div>

        <div class="col-md-4">
            <a class="quick-link"
               asp-area="Admin"
               asp-controller="Dashboard"
               asp-action="Module"
               asp-route-id="ThongKe">
                📊 Thống kê
            </a>
        </div>

    </div>
</div>
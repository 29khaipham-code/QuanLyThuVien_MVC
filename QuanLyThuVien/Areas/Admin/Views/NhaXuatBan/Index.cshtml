@model List<QuanLyThuVien.Models.NhaXuatBan>

@{
    ViewData["Title"] = "Quản lý nhà xuất bản";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    string keyword = ViewBag.Keyword as string ?? "";
    int page = ViewBag.Page ?? 1;
    int totalPages = ViewBag.TotalPages ?? 0;
    int totalItems = ViewBag.TotalItems ?? 0;
}

<style>
    /* THANH TIM KIEM AJAX */
    .nxb-search-container {
        position: relative;
        width: 100%;
    }

    .nxb-search-input {
        width: 100%;
    }

    /* DANH SACH GOI Y */
    .nxb-suggestions {
        display: none;
        position: absolute;
        top: calc(100% + 3px);
        left: 0;
        right: 0;
        z-index: 9999;
        background-color: #ffffff;
        border: 1px solid #ced4da;
        border-radius: 8px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        max-height: 300px;
        overflow-y: auto;
    }

    .nxb-suggestion-item {
        display: block;
        width: 100%;
        padding: 12px 15px;
        border: none;
        border-bottom: 1px solid #eeeeee;
        background: #ffffff;
        text-align: left;
        color: #212529;
        cursor: pointer;
        font-size: 14px;
    }

    .nxb-suggestion-item:hover,
    .nxb-suggestion-item.active {
        background-color: #eaf2ff;
        color: #0d6efd;
    }

    .nxb-suggestion-item:last-child {
        border-bottom: none;
    }

    .nxb-suggestion-message {
        padding: 12px 15px;
        color: #6c757d;
        font-size: 14px;
    }
</style>

<div class="container-fluid py-4">

    <!-- TIEU DE -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="fw-bold mb-1">
                Quản lý nhà xuất bản
            </h3>

            <p class="text-secondary mb-0">
                Danh sách các nhà xuất bản trong thư viện
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="NhaXuatBan"
           asp-action="Create"
           class="btn btn-primary">
            + Thêm nhà xuất bản
        </a>

    </div>

    <!-- THONG BAO -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <!-- TIM KIEM AJAX -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <form id="nxbSearchForm"
                  method="get"
                  asp-area="Admin"
                  asp-controller="NhaXuatBan"
                  asp-action="Index">

                <div class="row g-2">

                    <div class="col-md-9">

                        <div class="nxb-search-container"
                             id="nxbSearchContainer">

                            <input type="text"
                                   id="nxbSearchInput"
                                   name="keyword"
                                   value="@keyword"
                                   class="form-control nxb-search-input"
                                   placeholder="Tìm kiếm tên...."
                                   autocomplete="off"
                                   role="combobox"
                                   aria-autocomplete="list"
                                   aria-expanded="false"
                                   aria-controls="nxbSuggestionList" />

                            <!-- DANH SACH GOI Y -->
                            <div id="nxbSuggestionList"
                                 class="nxb-suggestions"
                                 role="listbox">
                            </div>

                        </div>

                    </div>

                    <div class="col-md-3 d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary flex-fill">
                            Tìm kiếm
                        </button>

                        <a asp-area="Admin"
                           asp-controller="NhaXuatBan"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            Đặt lại
                        </a>

                    </div>

                </div>

            </form>

        </div>
    </div>

    <!-- DANH SACH NHA XUAT BAN -->
    <div class="card shadow-sm">
        <div class="card-body">

            <div class="mb-3">
                Tổng số:
                <strong>@totalItems</strong>
                nhà xuất bản
            </div>

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Tên nhà xuất bản</th>
                            <th>Địa chỉ</th>
                            <th>Số điện thoại</th>
                            <th>Email</th>
                            <th>Website</th>
                            <th class="text-center">
                                Thao tác
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="7"
                                    class="text-center py-4">
                                    Không có nhà xuất bản nào.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>@item.Id</td>

                                    <td>
                                        <strong>
                                            @item.TenNhaXuatBan
                                        </strong>
                                    </td>

                                    <td>
                                        @(item.DiaChi ?? "—")
                                    </td>

                                    <td>
                                        @(item.SoDienThoai ?? "—")
                                    </td>

                                    <td>
                                        @(item.Email ?? "—")
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.Website))
                                        {
                                            <a href="@item.Website"
                                               target="_blank"
                                               rel="noopener noreferrer">
                                                Website
                                            </a>
                                        }
                                        else
                                        {
                                            <span>—</span>
                                        }
                                    </td>

                                    <td class="text-center">

                                        <div class="d-flex gap-2 justify-content-center">

                                            <!-- SUA -->
                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                Sửa
                                            </a>

                                            <!-- XOA -->
                                            <form asp-action="Delete"
                                                  asp-route-id="@item.Id"
                                                  method="post"
                                                  onsubmit="return confirm('Bạn có chắc muốn xóa nhà xuất bản này?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    Xóa
                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

            <!-- PHAN TRANG -->
            @if (totalPages > 1)
            {
                <nav class="mt-3">

                    <ul class="pagination justify-content-end">

                        @for (int i = 1; i <= totalPages; i++)
                        {
                            int currentPage = i;

                            <li class="page-item @(currentPage == page ? "active" : "")">

                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@currentPage"
                                   asp-route-keyword="@keyword">

                                    @currentPage

                                </a>

                            </li>
                        }

                    </ul>

                </nav>
            }

        </div>
    </div>

</div>

<!-- JAVASCRIPT AJAX AUTOCOMPLETE -->
<script>
    (function () {
        "use strict";

        function initNXBSearch() {

            const input = document.getElementById("nxbSearchInput");
            const list = document.getElementById("nxbSuggestionList");
            const form = document.getElementById("nxbSearchForm");
            const container = document.getElementById("nxbSearchContainer");

            if (!input || !list || !form || !container) {
                console.error("NXB AJAX: Khong tim thay HTML tim kiem.");
                return;
            }

            // URL cua API trong NhaXuatBanController
            const apiUrl = '@Url.Action("GoiY", "NhaXuatBan", new { area = "Admin" })';

            let timer = null;
            let abortController = null;
            let activeIndex = -1;

            // Dong danh sach goi y
            function closeSuggestions() {
                list.style.display = "none";
                list.replaceChildren();
                input.setAttribute("aria-expanded", "false");
                activeIndex = -1;
            }

            // Mo danh sach goi y
            function openSuggestions() {
                list.style.display = "block";
                input.setAttribute("aria-expanded", "true");
            }

            // Hien thong bao
            function showMessage(message) {
                list.replaceChildren();

                const div = document.createElement("div");
                div.className = "nxb-suggestion-message";
                div.textContent = message;

                list.appendChild(div);
                openSuggestions();
            }

            // Chon mot nha xuat ban
            function selectPublisher(name) {
                input.value = name;

                closeSuggestions();

                // Tu dong tim kiem sau khi chon
                form.requestSubmit();
            }

            // Ve danh sach goi y
            function renderSuggestions(data) {

                list.replaceChildren();
                activeIndex = -1;

                if (!Array.isArray(data) || data.length === 0) {
                    showMessage("Không tìm thấy nhà xuất bản phù hợp");
                    return;
                }

                data.forEach(function (name) {

                    const button = document.createElement("button");

                    button.type = "button";
                    button.className = "nxb-suggestion-item";
                    button.textContent = "🔍 " + name;
                    button.setAttribute("role", "option");
                    button.setAttribute("aria-selected", "false");

                    button.addEventListener("mousedown", function (event) {
                        event.preventDefault();
                    });

                    button.addEventListener("click", function () {
                        selectPublisher(name);
                    });

                    list.appendChild(button);
                });

                openSuggestions();
            }

            // Goi API AJAX
            async function searchPublishers(keyword) {

                if (abortController) {
                    abortController.abort();
                }

                const request = new AbortController();
                abortController = request;

                try {

                    const url = apiUrl
                        + "?term="
                        + encodeURIComponent(keyword);

                    const response = await fetch(url, {
                        method: "GET",
                        signal: request.signal,
                        headers: {
                            "Accept": "application/json"
                        }
                    });

                    if (!response.ok) {
                        throw new Error("HTTP " + response.status);
                    }

                    const contentType =
                        response.headers.get("content-type") || "";

                    if (!contentType.includes("application/json")) {
                        throw new Error("API khong tra ve JSON");
                    }

                    const data = await response.json();

                    // Khong hien ket qua cu
                    if (request.signal.aborted) {
                        return;
                    }

                    if (input.value.trim() !== keyword) {
                        return;
                    }

                    renderSuggestions(data);

                } catch (error) {

                    if (error.name === "AbortError") {
                        return;
                    }

                    console.error("NXB AJAX ERROR:", error);

                    showMessage(
                        "Không tải được gợi ý. Kiểm tra API GoiY."
                    );
                }
            }

            // Goi khi nguoi dung go tung ky tu
            input.addEventListener("input", function () {

                clearTimeout(timer);

                if (abortController) {
                    abortController.abort();
                }

                const keyword = input.value.trim();

                closeSuggestions();

                if (keyword.length === 0) {
                    return;
                }

                showMessage("Đang tìm kiếm...");

                timer = setTimeout(function () {
                    searchPublishers(keyword);
                }, 200);
            });

            // Khi focus vao o tim kiem
            input.addEventListener("focus", function () {

                const keyword = input.value.trim();

                if (keyword.length === 0) {
                    return;
                }

                clearTimeout(timer);

                showMessage("Đang tìm kiếm...");

                timer = setTimeout(function () {
                    searchPublishers(keyword);
                }, 200);
            });

            // Ho tro phim mui ten, Enter va Escape
            input.addEventListener("keydown", function (event) {

                const items = list.querySelectorAll(
                    ".nxb-suggestion-item"
                );

                if (event.key === "Escape") {
                    closeSuggestions();
                    return;
                }

                if (list.style.display !== "block") {
                    return;
                }

                if (event.key === "ArrowDown" && items.length > 0) {
                    event.preventDefault();
                    activeIndex = (activeIndex + 1) % items.length;
                }
                else if (event.key === "ArrowUp" && items.length > 0) {
                    event.preventDefault();
                    activeIndex =
                        (activeIndex - 1 + items.length) % items.length;
                }
                else if (event.key === "Enter" && activeIndex >= 0) {
                    event.preventDefault();
                    items[activeIndex].click();
                    return;
                }
                else {
                    return;
                }

                items.forEach(function (item, index) {

                    const isActive = index === activeIndex;

                    item.classList.toggle("active", isActive);

                    item.setAttribute(
                        "aria-selected",
                        isActive ? "true" : "false"
                    );
                });

                if (activeIndex >= 0) {
                    items[activeIndex].scrollIntoView({
                        block: "nearest"
                    });
                }
            });

            // Bam ra ngoai de dong
            document.addEventListener("click", function (event) {

                if (!container.contains(event.target)) {
                    closeSuggestions();
                }
            });

            // Khi submit form
            form.addEventListener("submit", function () {

                clearTimeout(timer);

                if (abortController) {
                    abortController.abort();
                }

                closeSuggestions();
            });

            console.log("NXB AJAX READY:", apiUrl);
        }

        // Dam bao HTML da tai xong
        if (document.readyState === "loading") {
            document.addEventListener(
                "DOMContentLoaded",
                initNXBSearch
            );
        } else {
            initNXBSearch();
        }

    })();
</script>

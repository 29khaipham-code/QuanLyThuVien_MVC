
@model QuanLyThuVien.ViewModels.NhaXuatBan.NhaXuatBanFormViewModel

@{
    ViewData["Title"] = "Thêm nhà xuất bản";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <h3 class="fw-bold">Thêm nhà xuất bản</h3>
        <p class="text-secondary">
            Nhập thông tin nhà xuất bản mới
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-4">

            <form asp-area="Admin"
                  asp-controller="NhaXuatBan"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row g-3">

                    <div class="col-md-12">
                        <label asp-for="TenNhaXuatBan"
                               class="form-label"></label>

                        <input asp-for="TenNhaXuatBan"
                               class="form-control"
                               placeholder="Nhập tên nhà xuất bản" />

                        <span asp-validation-for="TenNhaXuatBan"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="DiaChi"
                               class="form-label"></label>

                        <input asp-for="DiaChi"
                               class="form-control"
                               placeholder="Nhập địa chỉ" />

                        <span asp-validation-for="DiaChi"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="SoDienThoai"
                               class="form-label"></label>

                        <input asp-for="SoDienThoai"
                               class="form-control"
                               placeholder="Nhập số điện thoại" />

                        <span asp-validation-for="SoDienThoai"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email"
                               class="form-label"></label>

                        <input asp-for="Email"
                               class="form-control"
                               placeholder="Nhập email" />

                        <span asp-validation-for="Email"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Website"
                               class="form-label"></label>

                        <input asp-for="Website"
                               class="form-control"
                               placeholder="https://example.com" />

                        <span asp-validation-for="Website"
                              class="text-danger"></span>
                    </div>

                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit"
                            class="btn btn-primary">
                        Lưu nhà xuất bản
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Quay lại
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

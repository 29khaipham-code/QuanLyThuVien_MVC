@model List<QuanLyThuVien.ViewModels.Admin.Sach.SachListItemViewModel>

@{
    ViewData["Title"] = "Quản lý sách";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    string keyword = ViewBag.Keyword as string ?? "";
    int page = ViewBag.Page == null ? 1 : (int)ViewBag.Page;
    int totalPages = ViewBag.TotalPages == null
        ? 0 : (int)ViewBag.TotalPages;
    int total = ViewBag.Total == null
        ? 0 : (int)ViewBag.Total;
}


<style>
    .ajax-search-wrap { position: relative; width: 100%; }
    .ajax-search-menu { display: none; position: absolute; top: calc(100% + 4px); left: 0; right: 0;
        z-index: 10000; background: #fff; border: 1px solid #d4dce5; border-radius: 8px;
        box-shadow: 0 8px 22px rgba(0,0,0,.14); max-height: 320px; overflow-y: auto; }
    .ajax-search-choice { display: block; width: 100%; border: 0; background: #fff;
        padding: 10px 14px; text-align: left; cursor: pointer; border-bottom: 1px solid #eee; }
    .ajax-search-choice:hover, .ajax-search-choice:focus { background: #eaf2ff; }
    .ajax-search-detail { display: block; font-size: 12px; color: #6c757d; margin-top: 3px; }
    .ajax-search-status { padding: 12px 14px; color: #6c757d; }
</style>

<div class="container-fluid py-4">

    <!-- TIÊU ĐỀ VÀ NÚT THÊM -->
    <div class="d-flex justify-content-between
                align-items-center mb-4">

        <div>
            <h3 class="fw-bold mb-1">Quản lý sách</h3>
            <p class="text-muted mb-0">
                Tổng cộng @total đầu sách
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="SachAdmin"
           asp-action="Create"
           class="btn btn-primary">
            + Thêm sách mới
        </a>
    </div>

    <!-- THÔNG BÁO THÀNH CÔNG -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Đóng">
            </button>
        </div>
    }

    <!-- THÔNG BÁO LỖI -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Đóng">
            </button>
        </div>
    }

    <!-- TÌM KIẾM -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">

            <form asp-area="Admin"
                  asp-controller="SachAdmin"
                  asp-action="Index"
                  method="get">

                <div class="row g-2">
                    <div class="col-md-10">
                        <div class="ajax-search-wrap">
                            <input type="text" id="ajaxSearchInput" name="keyword"
                               value="@keyword"
                               class="form-control"
                               placeholder="Tìm theo tên sách hoặc ISBN..." autocomplete="off"
                                   role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="ajaxSearchMenu" />
                            <div id="ajaxSearchMenu" class="ajax-search-menu" role="listbox"></div>
                        </div>
                    </div>

                    <div class="col-md-2 d-flex gap-2">
                        <button type="submit"
                                class="btn btn-primary">
                            Tìm
                        </button>

                        <a asp-area="Admin"
                           asp-controller="SachAdmin"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            Xóa lọc
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- BẢNG DANH SÁCH SÁCH -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-3">

            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Ảnh bìa</th>
                            <th>ISBN</th>
                            <th>Tiêu đề</th>
                            <th>Thể loại</th>
                            <th>Nhà xuất bản</th>
                            <th>Năm XB</th>
                            <th>Trạng thái</th>
                            <th style="min-width:150px;">
                                Thao tác
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <!-- ẢNH BÌA -->
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.AnhBiaUrl))
                                    {
                                        <img src="@item.AnhBiaUrl"
                                             alt="Bìa @item.TieuDe"
                                             style="width:65px;
                                                    height:90px;
                                                    object-fit:cover;
                                                    border-radius:6px;
                                                    border:1px solid #ddd;" />
                                    }
                                    else
                                    {
                                        <div class="bg-light text-muted
                                                    d-flex align-items-center
                                                    justify-content-center"
                                             style="width:65px;height:90px;
                                                    border-radius:6px;
                                                    font-size:11px;">
                                            Chưa có ảnh
                                        </div>
                                    }
                                </td>

                                <!-- ISBN -->
                                <td>
                                    @(item.Isbn ?? "—")
                                </td>

                                <!-- TIÊU ĐỀ -->
                                <td>
                                    <strong>@item.TieuDe</strong>
                                </td>

                                <!-- THỂ LOẠI -->
                                <td>@item.TheLoai</td>

                                <!-- NHÀ XUẤT BẢN -->
                                <td>@item.NhaXuatBan</td>

                                <!-- NĂM XUẤT BẢN -->
                                <td>
                                    @(item.NamXuatBan?.ToString() ?? "—")
                                </td>

                                <!-- TRẠNG THÁI -->
                                <td>
                                    @if (item.TrangThai == "HoatDong")
                                    {
                                        <span class="badge bg-success">
                                            Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Ngừng phục vụ
                                        </span>
                                    }
                                </td>

                                <!-- NÚT SỬA VÀ XÓA -->
                                <td>
                                    <div class="d-flex gap-2 flex-nowrap">

                                        <!-- SỬA -->
                                        <a asp-area="Admin"
                                           asp-controller="SachAdmin"
                                           asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Sửa
                                        </a>

                                        <!-- XÓA -->
                                        <form asp-area="Admin"
                                              asp-controller="SachAdmin"
                                              asp-action="Delete"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              onsubmit="return confirm('Bạn có chắc muốn xóa sách này? Hành động không thể hoàn tác.');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Xóa
                                            </button>
                                        </form>

                                    </div>
                                </td>

                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8"
                                    class="text-center text-muted py-5">
                                    Không tìm thấy sách nào.
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>

            <!-- PHÂN TRANG -->
            @if (totalPages > 1)
            {
                <nav class="mt-3">
                    <ul class="pagination justify-content-end">

                        @for (int p = 1; p <= totalPages; p++)
                        {
                            <li class="page-item @(p == page ? "active" : "")">

                                <a class="page-link"
                                   href="@Url.Action(
                                       "Index",
                                       "SachAdmin",
                                       new
                                       {
                                           area = "Admin",
                                           keyword = keyword,
                                           page = p
                                       })">
                                    @p
                                </a>

                            </li>
                        }

                    </ul>
                </nav>
            }

        </div>
    </div>

</div>

<script>
(() => {
    "use strict";
    const input = document.getElementById("ajaxSearchInput");
    const menu = document.getElementById("ajaxSearchMenu");
    const form = input?.closest("form");
    if (!input || !menu || !form) return;

    const endpoint = '@Url.Action("GoiY", "SachAdmin", new { area = "Admin" })';
    let timer = null;
    let pending = null;
    let seq = 0;

    function hide() {
        menu.style.display = "none";
        menu.replaceChildren();
        input.setAttribute("aria-expanded", "false");
    }
    function showStatus(message) {
        menu.replaceChildren();
        const el = document.createElement("div");
        el.className = "ajax-search-status";
        el.textContent = message;
        menu.appendChild(el);
        menu.style.display = "block";
        input.setAttribute("aria-expanded", "true");
    }
    function showItems(items) {
        menu.replaceChildren();
        if (!Array.isArray(items) || items.length === 0) {
            showStatus("Không có kết quả phù hợp");
            return;
        }
        for (const row of items) {
            const btn = document.createElement("button");
            btn.type = "button";
            btn.className = "ajax-search-choice";
            const label = document.createElement("strong");
            label.textContent = row.label ?? row.value ?? "";
            const detail = document.createElement("span");
            detail.className = "ajax-search-detail";
            detail.textContent = row.detail ?? "";
            btn.append(label, detail);
            btn.addEventListener("click", () => {
                input.value = row.value ?? "";
                hide();
                form.requestSubmit();
            });
            menu.appendChild(btn);
        }
        menu.style.display = "block";
        input.setAttribute("aria-expanded", "true");
    }
    async function search(term, requestId) {
        pending?.abort();
        const abort = new AbortController();
        pending = abort;
        try {
            const response = await fetch(endpoint + "?term=" + encodeURIComponent(term), {
                signal: abort.signal, headers: { "Accept": "application/json" }
            });
            if (!response.ok) throw new Error("HTTP " + response.status);
            if (!(response.headers.get("content-type") ?? "").includes("application/json"))
                throw new Error("API không trả về JSON");
            const data = await response.json();
            if (!abort.signal.aborted && requestId === seq && input.value.trim() === term)
                showItems(data);
        } catch (err) {
            if (err.name !== "AbortError" && requestId === seq) {
                console.error("Lỗi API gợi ý:", err);
                showStatus("Không tải được gợi ý (kiểm tra API GoiY)");
            }
        }
    }
    function update() {
        clearTimeout(timer);
        pending?.abort();
        seq++;
        const requestId = seq;
        const term = input.value.trim();
        hide();
        if (!term) return;
        showStatus("Đang tìm...");
        timer = setTimeout(() => search(term, requestId), 180);
    }
    input.addEventListener("input", update);
    input.addEventListener("focus", () => { if (input.value.trim()) update(); });
    input.addEventListener("keydown", e => {
        if (e.key === "Escape") hide();
    });
    document.addEventListener("click", e => {
        if (!menu.contains(e.target) && e.target !== input) hide();
    });
    form.addEventListener("submit", () => { clearTimeout(timer); pending?.abort(); hide(); });
})();
</script>
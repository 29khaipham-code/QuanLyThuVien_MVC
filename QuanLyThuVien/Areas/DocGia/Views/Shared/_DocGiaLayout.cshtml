@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string c) => string.Equals(ctrl, c, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Góc độc giả</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body { background: #f4f6f9; }
        .dg-sidebar { width: 260px; background: #0f3d4c; color: #cfe3ea; }
        .dg-sidebar .brand { color: #fff; font-size: 1.15rem; font-weight: 600; padding: 1rem 1.25rem; display: block; text-decoration: none; }
        .dg-sidebar .section { color: #7fa6b3; font-size: .72rem; text-transform: uppercase; letter-spacing: .05em; padding: 1rem 1.25rem .25rem; }
        .dg-sidebar .nav-link { color: #cfe3ea; padding: .6rem 1.25rem; border-left: 3px solid transparent; }
        .dg-sidebar .nav-link:hover { background: #14516a; color: #fff; }
        .dg-sidebar .nav-link.active { background: #14516a; color: #fff; border-left-color: #4fd1c5; font-weight: 500; }
        .dg-sidebar .thecard { margin: .5rem 1rem; padding: .75rem; background: rgba(255,255,255,.08); border-radius: .5rem; font-size: .85rem; }
        @@media (min-width: 992px) {
            .dg-sidebar { position: fixed; top: 0; bottom: 0; left: 0; overflow-y: auto; }
            .dg-main { margin-left: 260px; }
        }
    </style>
</head>
<body>
    @* ===== SIDEBAR (cố định ở màn hình lớn, offcanvas ở điện thoại) ===== *@
    <div class="offcanvas-lg offcanvas-start dg-sidebar" tabindex="-1" id="dgSidebar">
        <div class="offcanvas-header d-lg-none">
            <span class="text-white fw-semibold">Góc độc giả</span>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#dgSidebar"></button>
        </div>
        <div class="offcanvas-body d-block p-0">
            <a class="brand" asp-area="DocGia" asp-controller="TongQuan" asp-action="Index">📚 Góc độc giả</a>

            <div class="thecard">
                <div class="fw-semibold text-white">@User.Identity?.Name</div>
                <div class="small">Vai trò: Độc giả</div>
            </div>

            <ul class="nav flex-column mt-2">
                <li><a class="nav-link @Active("TongQuan")" asp-area="DocGia" asp-controller="TongQuan" asp-action="Index">🏠 Tổng quan</a></li>

                <li class="section">Thư viện</li>
                <li><a class="nav-link" asp-area="" asp-controller="TraCuu" asp-action="Index">🔍 Tra cứu sách</a></li>
                <li><a class="nav-link @Active("DatTruoc")" asp-area="DocGia" asp-controller="DatTruoc" asp-action="Index">🔖 Đặt trước</a></li>
                <li><a class="nav-link @Active("SachDienTu")" asp-area="DocGia" asp-controller="SachDienTu" asp-action="Index">💻 Sách điện tử</a></li>

                <li class="section">Mượn trả</li>
                <li><a class="nav-link @Active("Muon")" asp-area="DocGia" asp-controller="Muon" asp-action="Index">📖 Đang mượn &amp; lịch sử</a></li>

                <li class="section">Tài khoản</li>
                <li><a class="nav-link @Active("HoSo")" asp-area="DocGia" asp-controller="HoSo" asp-action="Index">👤 Hồ sơ cá nhân</a></li>
                <li><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">↩ Về trang chủ</a></li>
            </ul>
        </div>
    </div>

    @* ===== NỘI DUNG ===== *@
    <div class="dg-main">
        <header class="bg-white border-bottom px-3 py-2 d-flex align-items-center justify-content-between">
            <button class="btn btn-outline-secondary d-lg-none" type="button"
                    data-bs-toggle="offcanvas" data-bs-target="#dgSidebar">☰</button>
            <h5 class="mb-0 d-none d-lg-block">@ViewData["Title"]</h5>
            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                <button class="btn btn-sm btn-outline-danger">Đăng xuất</button>
            </form>
        </header>

        <main class="p-3 p-lg-4">
            @if (TempData["ThongBao"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    @TempData["ThongBao"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Loi"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    @TempData["Loi"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@model QuanLyThuVien.ViewModels.DocGia.SachItemViewModel

@{
    string Anh(string u) => u.StartsWith("http", StringComparison.OrdinalIgnoreCase)
        ? u
        : Url.Content("~/" + u.TrimStart('~', '/'));
}

<div class="card dg-book-card h-100">

    <div class="dg-book-cover">
        @if (string.IsNullOrEmpty(Model.AnhBiaUrl))
        {
            <div class="dg-book-placeholder">
                <i class="bi bi-book"></i>
            </div>
        }
        else
        {
            <img src="@Anh(Model.AnhBiaUrl)"
                 alt="@Model.TieuDe"
                 loading="lazy" />
        }
    </div>

    <div class="card-body dg-book-info">
        <h6 class="dg-book-title">
            <a asp-area="DocGia"
               asp-controller="Sach"
               asp-action="ChiTiet"
               asp-route-id="@Model.Id">
                @Model.TieuDe
            </a>
        </h6>

        <div class="dg-book-author">
            <i class="bi bi-person me-1"></i>
            @Model.TacGia
        </div>

        <div class="dg-book-meta">
            @Model.TheLoai
            @(Model.NamXuatBan.HasValue ? " · " + Model.NamXuatBan : "")
        </div>
    </div>

    <div class="card-footer dg-book-footer">
        <div class="d-flex flex-wrap gap-2">
            @if (Model.SanSang > 0)
            {
                <span class="dg-book-badge dg-badge-available">
                    Còn @Model.SanSang/@Model.TongBanSao bản
                </span>
            }
            else if (Model.TongBanSao > 0)
            {
                <span class="dg-book-badge dg-badge-unavailable">
                    Tạm hết bản
                </span>
            }
            else if (!Model.CoSachDienTu)
            {
                <span class="dg-book-badge dg-badge-unavailable">
                    Chưa có bản
                </span>
            }

            @if (Model.CoSachDienTu)
            {
                <span class="dg-book-badge dg-badge-ebook">
                    <i class="bi bi-tablet me-1"></i>E-book
                </span>
            }
        </div>
    </div>

</div>

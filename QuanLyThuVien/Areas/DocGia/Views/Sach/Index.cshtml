@model QuanLyThuVien.ViewModels.DocGia.SachIndexViewModel

@{
    ViewData["Title"] = "Tra cứu sách";
}

@section Styles {
    <link rel="stylesheet" href="~/css/docGia/sach.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/docGia/danhsach.css" asp-append-version="true" />

}

<div class="container dg-sach-page">

    <!-- HEADER -->
    <section class="dg-sach-index-header" data-aos="fade-up">

        <div class="dg-sach-header-content">
            <div class="dg-sach-header-text">
                <span class="dg-sach-eyebrow">
                    <i class="bi bi-book-half me-2"></i>
                    KHÔNG GIAN TRI THỨC
                </span>

                <h1 class="dg-sach-page-title">
                    Khám phá thế giới <span>sách</span>
                </h1>

                <p class="dg-sach-page-description">
                    Tìm kiếm tài liệu, giáo trình và sách điện tử.
                    Hãy bắt đầu hành trình khám phá tri thức của bạn.
                </p>
            </div>

            <div class="dg-sach-header-decoration">
                <i class="bi bi-journal-bookmark"></i>
            </div>
        </div>

        <div class="dg-sach-header-line"></div>
    </section>

    <!-- FILTER -->
    <section class="dg-filter-card" data-aos="fade-up" data-aos-delay="100">

        <div class="dg-filter-heading">
            <div class="dg-filter-icon">
                <i class="bi bi-sliders"></i>
            </div>

            <div>
                <h5>Tìm kiếm sách</h5>
                <p>Sử dụng bộ lọc để tìm cuốn sách bạn cần</p>
            </div>
        </div>

        <form id="formLoc"
              method="get"
              asp-area="DocGia"
              asp-controller="Sach"
              asp-action="Index"
              class="row g-3 align-items-end">

            <!-- TỪ KHÓA -->
            <div class="col-12 col-lg-4">
                <label class="dg-filter-label" for="tuKhoa">
                    Từ khóa
                </label>

                <div class="input-group dg-input-group">
                    <span class="input-group-text">
                        <i class="bi bi-search"></i>
                    </span>

                    <input id="tuKhoa"
                           name="tuKhoa"
                           value="@Model.TuKhoa"
                           class="form-control"
                           placeholder="Tên sách, tác giả, ISBN..."
                           autocomplete="off" />
                </div>
            </div>

            <!-- THỂ LOẠI -->
            <div class="col-6 col-lg-2">
                <label class="dg-filter-label" for="theLoaiId">
                    Thể loại
                </label>

                <select id="theLoaiId"
                        name="theLoaiId"
                        class="form-select dg-filter-control">
                    <option value="">Tất cả</option>

                    @foreach (var o in Model.TheLoais)
                    {
                        <option value="@o.Id" selected="@(o.Id == Model.TheLoaiId)">
                            @o.Ten
                        </option>
                    }
                </select>
            </div>

            <!-- NHÀ XUẤT BẢN -->
            <div class="col-6 col-lg-2">
                <label class="dg-filter-label" for="nhaXuatBanId">
                    Nhà xuất bản
                </label>

                <select id="nhaXuatBanId"
                        name="nhaXuatBanId"
                        class="form-select dg-filter-control">
                    <option value="">Tất cả</option>

                    @foreach (var o in Model.NhaXuatBans)
                    {
                        <option value="@o.Id" selected="@(o.Id == Model.NhaXuatBanId)">
                            @o.Ten
                        </option>
                    }
                </select>
            </div>

            <!-- SẮP XẾP -->
            <div class="col-6 col-lg-2">
                <label class="dg-filter-label" for="sapXep">
                    Sắp xếp
                </label>

                <select id="sapXep"
                        name="sapXep"
                        class="form-select dg-filter-control">
                    <option value="moi" selected="@(Model.SapXep == "moi")">
                        Mới nhất
                    </option>
                    <option value="ten" selected="@(Model.SapXep == "ten")">
                        Tên A-Z
                    </option>
                    <option value="nam" selected="@(Model.SapXep == "nam")">
                        Năm xuất bản
                    </option>
                </select>
            </div>

            <!-- CÒN SÁCH + BUTTON -->
            <div class="col-6 col-lg-2">
                <div class="dg-filter-last-row">

                    <div class="form-check dg-available-check">
                        <input id="conSach"
                               name="conSach"
                               type="checkbox"
                               value="true"
                               class="form-check-input"
                               checked="@Model.ConSach" />

                        <label class="form-check-label" for="conSach">
                            Còn sách
                        </label>
                    </div>

                    <button type="submit"
                            class="dg-search-submit-btn"
                            aria-label="Tìm kiếm">
                        <i class="bi bi-search"></i>
                    </button>

                </div>
            </div>

        </form>
    </section>

    <!-- RESULTS -->
    <section id="ketQua"
             class="dg-results-container"
             data-aos="fade-up"
             data-aos-delay="150">

        <partial name="_DanhSach" model="Model" />

    </section>

</div>

@section Scripts {
    <script>
        (function () {
            var $ketQua = $('#ketQua');
            var $form = $('#formLoc');

            // Tải lại danh sách bằng AJAX
            function tai(url) {
                $ketQua.addClass('dg-results-loading');

                $.ajax({
                    url: url,
                    method: 'GET',
                    cache: false
                })
                    .done(function (html) {
                        $ketQua.html(html);
                        history.pushState(null, '', url);

                        // Cập nhật AOS cho các phần tử vừa được render
                        if (window.AOS) {
                            AOS.refreshHard();
                        }
                    })
                    .fail(function () {
                        $ketQua.html(`
                                <div class="dg-filter-error">
                                    <i class="bi bi-exclamation-circle"></i>
                                    <span>Không tải được dữ liệu, vui lòng thử lại.</span>
                                </div>
                            `);
                    })
                    .always(function () {
                        $ketQua.removeClass('dg-results-loading');
                    });
            }

            // Submit bộ lọc
            $form.on('submit', function (e) {
                e.preventDefault();

                var query = $form.serialize();
                var url = $form.attr('action');

                tai(url + (query ? '?' + query : ''));
            });

            // Thay đổi select / checkbox thì lọc ngay
            $form.find('select, input[type="checkbox"]').on('change', function () {
                $form.trigger('submit');
            });

            // Tìm kiếm từ khóa có debounce
            var timer;

            $('#tuKhoa').on('input', function () {
                clearTimeout(timer);

                timer = setTimeout(function () {
                    $form.trigger('submit');
                }, 400);
            });

            // Phân trang AJAX
            $ketQua.on('click', '.pagination a', function (e) {
                e.preventDefault();

                var url = $(this).attr('href');

                if (url) {
                    tai(url);
                    window.scrollTo({
                        top: 0,
                        behavior: 'smooth'
                    });
                }
            });

            // Back / Forward trình duyệt
            window.addEventListener('popstate', function () {
                location.reload();
            });

        })();
    </script>
}

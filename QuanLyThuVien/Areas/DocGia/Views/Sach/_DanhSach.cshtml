@model QuanLyThuVien.ViewModels.DocGia.SachIndexViewModel;

@{
    // Tạo link phân trang, giữ nguyên bộ lọc
    string Link(int trang) => Url.Action("Index", "Sach", new
    {
        area = "DocGia",
        tuKhoa = Model.TuKhoa,
        theLoaiId = Model.TheLoaiId,
        nhaXuatBanId = Model.NhaXuatBanId,
        conSach = Model.ConSach ? "true" : null,
        sapXep = Model.SapXep,
        trang
    })!;

    var phanTrang = new PhanTrangViewModel
    {
        Trang = Model.Trang,
        TongTrang = Model.TongTrang,
        Link = Link
    };
}

<div class="dg-list-result">

    <!-- Thông tin kết quả -->
    <div class="dg-result-summary">
        <div class="dg-result-count">
            <i class="bi bi-journal-bookmark"></i>
            <span>Tìm thấy</span>
            <strong>@Model.TongSo</strong>
            <span>đầu sách</span>
        </div>
    </div>

    @if (!Model.Items.Any())
    {
        <div class="dg-empty-state">
            <div class="dg-empty-icon">
                <i class="bi bi-book"></i>
            </div>

            <h5>Chưa tìm thấy cuốn sách phù hợp</h5>

            <p>
                Hãy thử thay đổi từ khóa hoặc bỏ bớt một số bộ lọc
                để khám phá thêm những cuốn sách khác nhé.
            </p>
        </div>
    }
    else
    {
        <!-- Danh sách sách: tái sử dụng card trang chủ -->
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var s in Model.Items)
            {
                <div class="col" data-aos="fade-up">
                    <partial name="_SachCard" model="s" />
                </div>
            }
        </div>

        <partial name="_PhanTrang" model="phanTrang" />
    }
</div>

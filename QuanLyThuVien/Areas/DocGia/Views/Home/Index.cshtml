@using System.Globalization
@model QuanLyThuVien.ViewModels.TrangChu.TrangChuViewModel

@{
    ViewData["Title"] = "Trang chủ";

    var vi = new CultureInfo("vi-VN");
    var daDangNhap = User.Identity?.IsAuthenticated == true;
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/docgia/trangchu.css"
          asp-append-version="true" />
}
<div class="container dg-home-container">

    @if (Model.Banners.Any())
    {
        <div id="bannerTrangChu"
             class="carousel slide mb-4"
             data-bs-ride="carousel"
             data-bs-interval="5000"
             data-aos="fade-up"
             data-aos-duration="900">

            @if (Model.Banners.Count > 1)
            {
                <div class="carousel-indicators">
                    @for (var i = 0; i < Model.Banners.Count; i++)
                    {
                        <button type="button"
                                data-bs-target="#bannerTrangChu"
                                data-bs-slide-to="@i"
                                class="@(i == 0 ? "active" : "")"
                                aria-current="@(i == 0 ? "true" : null)"
                                aria-label="Banner @(i + 1)">
                        </button>
                    }
                </div>
            }

            <div class="carousel-inner rounded-3 shadow-sm">

                @for (var i = 0; i < Model.Banners.Count; i++)
                {
                    var b = Model.Banners[i];

                    var kieu = string.IsNullOrEmpty(b.AnhUrl)
                        ? null
                        : $"background-image:linear-gradient(rgba(0,0,0,.45),rgba(0,0,0,.45)),url('{Url.Content("~/" + b.AnhUrl.TrimStart('~', '/'))}')";

                    <div class="carousel-item @(i == 0 ? "active" : "")">

                        <div class="dg-banner @b.LopNen"
                             style="@kieu">

                            <div class="dg-banner-body text-white">

                                <h2 class="display-6 fw-semibold">
                                    @b.TieuDe
                                </h2>

                                <p class="lead mb-3">
                                    @b.MoTa
                                </p>

                                <a class="btn btn-light"
                                   href="@b.Url">
                                    @b.NutChu
                                </a>

                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (Model.Banners.Count > 1)
            {
                <button class="carousel-control-prev"
                        type="button"
                        data-bs-target="#bannerTrangChu"
                        data-bs-slide="prev">

                    <span class="carousel-control-prev-icon"
                          aria-hidden="true">
                    </span>

                    <span class="visually-hidden">Trước</span>
                </button>

                <button class="carousel-control-next"
                        type="button"
                        data-bs-target="#bannerTrangChu"
                        data-bs-slide="next">

                    <span class="carousel-control-next-icon"
                          aria-hidden="true">
                    </span>

                    <span class="visually-hidden">Sau</span>
                </button>
            }
        </div>
    }


    <!-- ==========================================
     2. KHU VỰC CÁ NHÂN
========================================== -->
    @if (!Model.LaDocGia && !daDangNhap)
    {
        @* Khách chưa đăng nhập *@

        <div class="alert alert-info dg-home-alert
            d-flex flex-wrap justify-content-between
            align-items-center gap-2 mb-4"
             data-aos="fade-up"
             data-aos-delay="100">

            <div>
                <i class="bi bi-info-circle me-1"></i>

                Bạn đang xem với tư cách khách.
                Hãy đăng nhập để đặt trước sách, theo dõi mượn trả
                và đọc sách điện tử.
            </div>

            <a class="btn btn-primary btn-sm"
               asp-area=""
               asp-controller="Account"
               asp-action="Login">

                <i class="bi bi-box-arrow-in-right me-1"></i>
                Đăng nhập
            </a>
        </div>
    }
    else if (!Model.LaDocGia)
    {
        @* Đã đăng nhập nhưng không phải độc giả *@

        <div class="alert alert-secondary dg-home-alert mb-4"
             data-aos="fade-up"
             data-aos-delay="100">

            <i class="bi bi-person-badge me-1"></i>

            Bạn đang đăng nhập bằng tài khoản nhân viên,
            nên các chức năng dành riêng cho độc giả
            (mượn trả, đặt trước, hồ sơ độc giả) không khả dụng ở đây.
        </div>
    }
    else if (!Model.CoHoSo)
    {
        @* Tài khoản chưa có hồ sơ độc giả *@

        <div class="alert alert-warning dg-home-alert mb-4"
             data-aos="fade-up"
             data-aos-delay="100">

            <i class="bi bi-exclamation-triangle me-1"></i>

            Tài khoản của bạn chưa được gắn với hồ sơ độc giả,
            nên chưa thể xem thông tin mượn trả.

            Vui lòng liên hệ thủ thư để được hỗ trợ.
        </div>
    }
    else
    {
        @* Độc giả đã có hồ sơ *@

        @if (!Model.TheConHieuLuc)
        {
            <div class="alert alert-warning dg-home-alert mb-4"
                 data-aos="fade-up">

                <i class="bi bi-exclamation-triangle me-1"></i>

                Thẻ thư viện của bạn đã hết hạn hoặc đang bị khóa
                (hạn thẻ: @Model.NgayHetHan.ToString("dd/MM/yyyy")).

                Vui lòng liên hệ thủ thư để gia hạn.
            </div>
        }

        <!-- THỐNG KÊ ĐỘC GIẢ -->

        <div class="row g-3 mb-4">

            <!-- Đang mượn -->
            <div class="col-6 col-lg-3"
                 data-aos="fade-up"
                 data-aos-delay="0">

                <div class="dg-stat-card">

                    <div class="dg-stat-icon">
                        <i class="bi bi-book"></i>
                    </div>

                    <div class="dg-stat-label">
                        Xin chào, @Model.HoTen
                    </div>

                    <div class="dg-stat-value">
                        Đang mượn @Model.DangMuon / @Model.SoSachToiDa
                    </div>

                </div>
            </div>

            <!-- Sắp đến hạn -->
            <div class="col-6 col-lg-3"
                 data-aos="fade-up"
                 data-aos-delay="100">

                <div class="dg-stat-card">

                    <div class="dg-stat-icon">
                        <i class="bi bi-calendar-check"></i>
                    </div>

                    <div class="dg-stat-label">
                        Sắp đến hạn (3 ngày)
                    </div>

                    <div class="dg-stat-value @(Model.SapDenHan > 0 ? "text-warning" : "")">
                        @Model.SapDenHan cuốn
                    </div>

                </div>
            </div>

            <!-- Quá hạn -->
            <div class="col-6 col-lg-3"
                 data-aos="fade-up"
                 data-aos-delay="200">

                <div class="dg-stat-card">

                    <div class="dg-stat-icon">
                        <i class="bi bi-exclamation-circle"></i>
                    </div>

                    <div class="dg-stat-label">
                        Quá hạn
                    </div>

                    <div class="dg-stat-value @(Model.QuaHan > 0 ? "text-danger" : "")">
                        @Model.QuaHan cuốn
                    </div>

                </div>
            </div>

            <!-- Phạt chưa thanh toán -->
            <div class="col-6 col-lg-3"
                 data-aos="fade-up"
                 data-aos-delay="300">

                <div class="dg-stat-card">

                    <div class="dg-stat-icon">
                        <i class="bi bi-cash-coin"></i>
                    </div>

                    <div class="dg-stat-label">
                        Phạt chưa thanh toán
                    </div>

                    <div class="dg-stat-value @(Model.PhatChuaThanhToan > 0 ? "text-danger" : "")">

                        @string.Format(
                            vi,
                            "{0:N0} đ",
                            Model.PhatChuaThanhToan
                        )

                    </div>
                </div>
            </div>

        </div>
    }


    <!-- ==========================================
     3. CÁC KỆ SÁCH
========================================== -->
    @foreach (var ke in Model.KeSach.Where(k => k.Items.Any()))
    {
        <div class="dg-home-section"
             data-aos="fade-up"
             data-aos-duration="800">

            <partial name="_KeSach" model="ke" />

        </div>
    }


    <!-- ==========================================
     4. KHÁM PHÁ THEO CHỦ ĐỀ
========================================== -->
    @if (Model.TheLoais.Any())
    {
        <section class="dg-home-section"
                 data-aos="fade-up"
                 data-aos-duration="800">

            <h5 class="dg-section-title">
                <i class="bi bi-tags"></i>
                Khám phá theo chủ đề
            </h5>

            <div class="d-flex flex-wrap gap-2">

                @foreach (var t in Model.TheLoais)
                {
                    <a class="btn btn-sm dg-topic-btn"
                       asp-area="DocGia"
                       asp-controller="Sach"
                       asp-action="Index"
                       asp-route-theLoaiId="@t.Id">

                        @t.Ten

                        <span class="badge rounded-pill ms-1">
                            @t.SoSach
                        </span>

                    </a>
                }

            </div>
        </section>
    }


    <!-- ==========================================
     5. KỆ SÁCH THEO CHỦ ĐỀ
========================================== -->
    @foreach (var ke in Model.KeTheoChuDe.Where(k => k.Items.Any()))
    {
        <div class="dg-home-section"
             data-aos="fade-up"
             data-aos-duration="800">

            <partial name="_KeSach" model="ke" />

        </div>
    }


</div>


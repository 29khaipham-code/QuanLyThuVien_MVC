@model QuanLyThuVien.ViewModels.DocGia.LichSuMuonViewModel

@{
    // Link phân trang, giữ nguyên bộ lọc
    string Link(int trang) => Url.Action("LichSu", "MuonTra", new
    {
        area = "DocGia",
        tuKhoa = Model.TuKhoa,
        trangThai = Model.TrangThai,
        tuNgay = Model.TuNgay?.ToString("yyyy-MM-dd"),
        denNgay = Model.DenNgay?.ToString("yyyy-MM-dd"),
        trang
    })!;

    var phanTrang = new PhanTrangViewModel
    {
        Trang = Model.Trang,
        TongTrang = Model.TongTrang,
        Link = Link
    };
}

<div class="dg-history-list">

    @* Thông tin kết quả *@
    <div class="dg-history-result-summary">
        <div class="dg-history-result-icon">
            <i class="bi bi-journal-check"></i>
        </div>

        <div>
            <span class="dg-history-result-label">Kết quả tìm kiếm</span>
            <div class="dg-history-result-count">
                Tìm thấy <strong>@Model.TongSo</strong> lượt mượn
            </div>
        </div>
    </div>

    @if (!Model.Items.Any())
    {
        <div class="dg-history-empty">
            <div class="dg-history-empty-icon">
                <i class="bi bi-journal-x"></i>
            </div>

            <h5>Không tìm thấy lượt mượn</h5>

            <p>
                Không có lượt mượn nào phù hợp với bộ lọc hiện tại.
                Hãy thử thay đổi từ khóa hoặc điều kiện tìm kiếm.
            </p>
        </div>
    }
    else
    {
        <div class="dg-history-table-card">
            <div class="table-responsive">
                <table class="table dg-history-table align-middle">
                    <thead>
                        <tr>
                            <th>Sách</th>
                            <th>Phiếu</th>
                            <th>Ngày mượn</th>
                            <th>Hạn trả</th>
                            <th>Ngày trả</th>
                            <th>Tình trạng</th>
                            <th class="text-end">Tiền phạt</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var m in Model.Items)
                        {
                            <tr>
                                @* Tên sách *@
                                <td>
                                    <a class="dg-history-book-link"
                                       asp-area="DocGia"
                                       asp-controller="Sach"
                                       asp-action="ChiTiet"
                                       asp-route-id="@m.SachId">
                                        <i class="bi bi-book"></i>
                                        <span>@m.TieuDe</span>
                                    </a>
                                </td>

                                @* Mã phiếu *@
                                <td>
                                    <span class="dg-history-ticket">
                                        @m.MaPhieu
                                    </span>
                                </td>

                                @* Ngày mượn *@
                                <td>
                                    <span class="dg-history-date">
                                        @m.NgayMuon.ToString("dd/MM/yyyy")
                                    </span>
                                </td>

                                @* Hạn trả *@
                                <td>
                                    <span class="dg-history-date">
                                        @m.HanTra.ToString("dd/MM/yyyy")
                                    </span>
                                </td>

                                @* Ngày trả *@
                                <td>
                                    <span class="dg-history-date">
                                        @(m.NgayTra.HasValue
                                            ? m.NgayTra.Value.ToString("dd/MM/yyyy")
                                            : "—")
                                    </span>
                                </td>

                                @* Trạng thái *@
                                <td>
                                    <span class="dg-history-status @m.LopBadge">
                                        @m.TrangThaiText
                                    </span>
                                </td>

                                @* Tiền phạt *@
                                <td class="text-end">
                                    @if (m.TongPhat > 0)
                                    {
                                        <strong class="dg-history-fine @(m.PhatChuaNop > 0 ? "is-unpaid" : "is-paid")">
                                            @HienThi.Tien(m.TongPhat)
                                        </strong>
                                    }
                                    else
                                    {
                                        <span class="dg-history-no-fine">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @* Phân trang *@
        <div class="dg-history-pagination">
            <partial name="_PhanTrang" model="phanTrang" />
        </div>
    }

</div>
@model QuanLyThuVien.ViewModels.DocGia.LichSuMuonViewModel;
@{
    ViewData["Title"] = "Lịch sử mượn";
    ViewData["Tab"] = "lichsu";
}

<h2 class="mb-3">Mượn trả</h2>

<partial name="_MuonTraTabs" />

<form id="formLoc" method="get"
      asp-area="DocGia" asp-controller="MuonTra" asp-action="LichSu"
      class="row g-2 align-items-end mb-4">

    <div class="col-12 col-md-4">
        <label class="form-label" for="tuKhoa">Từ khóa</label>
        <input id="tuKhoa" name="tuKhoa" value="@Model.TuKhoa" class="form-control"
               placeholder="Tên sách hoặc mã phiếu" autocomplete="off" />
    </div>

    <div class="col-6 col-md-2">
        <label class="form-label" for="trangThai">Trạng thái</label>
        <select id="trangThai" name="trangThai" class="form-select">
            <option value="tatca" selected="@(Model.TrangThai == "tatca")">Tất cả</option>
            <option value="dangmuon" selected="@(Model.TrangThai == "dangmuon")">Đang mượn</option>
            <option value="datra" selected="@(Model.TrangThai == "datra")">Đã trả</option>
            <option value="tramuon" selected="@(Model.TrangThai == "tramuon")">Trả muộn</option>
        </select>
    </div>

    <div class="col-6 col-md-2">
        <label class="form-label" for="tuNgay">Mượn từ ngày</label>
        <input id="tuNgay" name="tuNgay" type="date" class="form-control"
               value="@Model.TuNgay?.ToString("yyyy-MM-dd")" />
    </div>

    <div class="col-6 col-md-2">
        <label class="form-label" for="denNgay">Đến ngày</label>
        <input id="denNgay" name="denNgay" type="date" class="form-control"
               value="@Model.DenNgay?.ToString("yyyy-MM-dd")" />
    </div>

    <div class="col-6 col-md-2">
        <button type="submit" class="btn btn-primary w-100">
            <i class="bi bi-funnel me-1"></i>Lọc
        </button>
    </div>
</form>

<div id="ketQua">
    <partial name="_LichSuDanhSach" model="Model" />
</div>

@section Scripts {
    <script>
        (function () {
            var $ketQua = $('#ketQua');
            var $form = $('#formLoc');

            // Tải lại phần danh sách bằng AJAX, giữ nguyên bộ lọc
            function tai(url) {
                $ketQua.css('opacity', 0.5);
                $.ajax({ url: url, method: 'GET', cache: false })
                    .done(function (html) {
                        $ketQua.html(html);
                        history.pushState(null, '', url);
                    })
                    .fail(function () {
                        $ketQua.html('<div class="alert alert-danger">Không tải được dữ liệu, vui lòng thử lại.</div>');
                    })
                    .always(function () {
                        $ketQua.css('opacity', 1);
                    });
            }

            $form.on('submit', function (e) {
                e.preventDefault();
                tai($form.attr('action') + '?' + $form.serialize());
            });

            // Đổi trạng thái hoặc ngày thì lọc ngay
            $form.find('select, input[type=date]').on('change', function () {
                $form.trigger('submit');
            });

            // Gõ từ khóa: chờ 400ms sau lần gõ cuối rồi mới lọc
            var timer;
            $('#tuKhoa').on('input', function () {
                clearTimeout(timer);
                timer = setTimeout(function () { $form.trigger('submit'); }, 400);
            });

            // Bấm số trang
            $ketQua.on('click', '.pagination a', function (e) {
                e.preventDefault();
                tai($(this).attr('href'));
            });

            // Nút Back/Forward của trình duyệt
            window.addEventListener('popstate', function () { location.reload(); });
        })();
    </script>
}

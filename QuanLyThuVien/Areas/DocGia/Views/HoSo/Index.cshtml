@model QuanLyThuVien.ViewModels.DocGia.HoSoViewModel

@{
    ViewData["Title"] = "Hồ sơ cá nhân";

    string Anh(string u) => u.StartsWith("http", StringComparison.OrdinalIgnoreCase)
        ? u
        : Url.Content("~/" + u.TrimStart('~', '/'));
}

@section Styles {
    <link rel="stylesheet" href="~/css/docgia/hoso.css" asp-append-version="true" />
}

<div class="container dg-profile-page">

    <partial name="_ThongBao" />

    @* Header *@
    <header class="dg-profile-header" data-aos="fade-up">
        <div class="dg-profile-eyebrow">
            <i class="bi bi-person-circle"></i>
            <span>KHÔNG GIAN ĐỌC SÁCH</span>
        </div>

        <h1 class="dg-profile-title">
            Hồ sơ <span>cá nhân</span>
        </h1>

        <p class="dg-profile-description">
            Quản lý thông tin cá nhân, tài khoản và thẻ thư viện
            của bạn tại thư viện.
        </p>
    </header>

    <div class="row g-4">

        @* =====================================
           CỘT TRÁI: ẢNH ĐẠI DIỆN
        ====================================== *@

        <div class="col-12 col-md-4 col-lg-3" data-aos="fade-up" data-aos-delay="100">
            <div class="dg-profile-sidebar">

                <div class="dg-profile-avatar-card">

                    <div class="dg-profile-avatar-wrapper">
                        @if (string.IsNullOrEmpty(Model.AnhDaiDienUrl))
                        {
                            <div class="dg-profile-avatar-placeholder">
                                <i class="bi bi-person"></i>
                            </div>
                        }
                        else
                        {
                            <img src="@Anh(Model.AnhDaiDienUrl)"
                                 alt="Ảnh đại diện"
                                 class="dg-profile-avatar" />
                        }

                        <span class="dg-profile-avatar-decoration">
                            <i class="bi bi-camera-fill"></i>
                        </span>
                    </div>

                    <h4 class="dg-profile-name">@Model.HoTen</h4>

                    <div class="dg-profile-member-code">
                        <i class="bi bi-person-badge"></i>
                        @Model.MaDocGia
                    </div>

                    <span class="dg-profile-member-type">
                        @Model.LoaiDocGia
                    </span>

                    <div class="dg-profile-divider"></div>

                    @* Đổi ảnh đại diện *@
                    <form method="post"
                          enctype="multipart/form-data"
                          asp-area="DocGia"
                          asp-controller="HoSo"
                          asp-action="DoiAnhDaiDien">

                        <label class="dg-profile-upload-label" for="anh">
                            <i class="bi bi-image"></i>
                            Chọn ảnh đại diện
                        </label>

                        <input id="anh"
                               type="file"
                               name="anh"
                               accept=".jpg,.jpeg,.png,.webp"
                               class="form-control dg-profile-file-input"
                               required />

                        <button type="submit" class="dg-profile-upload-btn">
                            <i class="bi bi-cloud-arrow-up"></i>
                            Cập nhật ảnh
                        </button>
                    </form>

                    @if (!string.IsNullOrEmpty(Model.AnhDaiDienUrl))
                    {
                        <form method="post"
                              asp-area="DocGia"
                              asp-controller="HoSo"
                              asp-action="XoaAnhDaiDien"
                              onsubmit="return confirm('Xóa ảnh đại diện hiện tại?');"
                              class="mt-2">

                            <button type="submit" class="dg-profile-delete-btn">
                                <i class="bi bi-trash3"></i>
                                Xóa ảnh đại diện
                            </button>
                        </form>
                    }

                    <p class="dg-profile-upload-note">
                        JPG, PNG hoặc WEBP. Dung lượng tối đa 2 MB.
                    </p>

                </div>
            </div>
        </div>

        @* =====================================
           CỘT PHẢI: THÔNG TIN
        ====================================== *@

        <div class="col-12 col-md-8 col-lg-9">

            @* Thông tin cá nhân *@
            <section class="dg-profile-section" data-aos="fade-up" data-aos-delay="150">

                <div class="dg-profile-section-header">
                    <div class="dg-profile-section-heading">
                        <div class="dg-profile-section-icon">
                            <i class="bi bi-person-vcard"></i>
                        </div>

                        <div>
                            <h4>Thông tin cá nhân</h4>
                            <p>Thông tin cơ bản và liên hệ của bạn</p>
                        </div>
                    </div>

                    <div class="dg-profile-actions">
                        <a class="dg-profile-action-btn dg-profile-edit-btn"
                           asp-area="DocGia"
                           asp-controller="HoSo"
                           asp-action="Sua">
                            <i class="bi bi-pencil-square"></i>
                            <span>Chỉnh sửa</span>
                        </a>

                        <a class="dg-profile-action-btn dg-profile-password-btn"
                           asp-area="DocGia"
                           asp-controller="HoSo"
                           asp-action="DoiMatKhau">
                            <i class="bi bi-key"></i>
                            <span>Đổi mật khẩu</span>
                        </a>
                    </div>
                </div>

                <div class="dg-profile-section-body">
                    <dl class="dg-profile-info-list">

                        <div class="dg-profile-info-item">
                            <dt>
                                <i class="bi bi-person"></i>
                                Tên đăng nhập
                            </dt>
                            <dd>@Model.TenDangNhap</dd>
                        </div>

                        <div class="dg-profile-info-item">
                            <dt>
                                <i class="bi bi-person-badge"></i>
                                Họ và tên
                            </dt>
                            <dd>@Model.HoTen</dd>
                        </div>

                        <div class="dg-profile-info-item">
                            <dt>
                                <i class="bi bi-calendar3"></i>
                                Ngày sinh
                            </dt>
                            <dd>
                                @(Model.NgaySinh.HasValue
                                    ? Model.NgaySinh.Value.ToString("dd/MM/yyyy")
                                    : "—")
                            </dd>
                        </div>

                        <div class="dg-profile-info-item">
                            <dt>
                                <i class="bi bi-gender-ambiguous"></i>
                                Giới tính
                            </dt>
                            <dd>
                                @(string.IsNullOrEmpty(Model.GioiTinh) ? "—" : Model.GioiTinh)
                            </dd>
                        </div>

                        <div class="dg-profile-info-item">
                            <dt>
                                <i class="bi bi-envelope"></i>
                                Email
                            </dt>
                            <dd>
                                @(string.IsNullOrEmpty(Model.Email) ? "—" : Model.Email)
                            </dd>
                        </div>

                        <div class="dg-profile-info-item">
                            <dt>
                                <i class="bi bi-telephone"></i>
                                Số điện thoại
                            </dt>
                            <dd>
                                @(string.IsNullOrEmpty(Model.SoDienThoai) ? "—" : Model.SoDienThoai)
                            </dd>
                        </div>

                        <div class="dg-profile-info-item dg-profile-info-address">
                            <dt>
                                <i class="bi bi-geo-alt"></i>
                                Địa chỉ
                            </dt>
                            <dd>
                                @(string.IsNullOrEmpty(Model.DiaChi) ? "—" : Model.DiaChi)
                            </dd>
                        </div>

                    </dl>
                </div>
            </section>

            @* Thẻ thư viện *@
            <section class="dg-profile-section dg-profile-library-card"
                     data-aos="fade-up"
                     data-aos-delay="200">

                <div class="dg-profile-section-header">
                    <div class="dg-profile-section-heading">
                        <div class="dg-profile-section-icon">
                            <i class="bi bi-card-checklist"></i>
                        </div>

                        <div>
                            <h4>Thẻ thư viện</h4>
                            <p>Thông tin và quyền sử dụng thẻ của bạn</p>
                        </div>
                    </div>

                    @if (Model.TheConHieuLuc)
                    {
                        <span class="dg-profile-card-status is-valid">
                            <i class="bi bi-check-circle-fill"></i>
                            Còn hiệu lực
                        </span>
                    }
                    else
                    {
                        <span class="dg-profile-card-status is-invalid">
                            <i class="bi bi-exclamation-circle-fill"></i>
                            Hết hạn hoặc bị khóa
                        </span>
                    }
                </div>

                <div class="dg-profile-section-body">

                    @* Thông tin thẻ *@
                    <dl class="dg-profile-info-list">

                        <div class="dg-profile-info-item">
                            <dt>
                                <i class="bi bi-upc-scan"></i>
                                Mã độc giả
                            </dt>
                            <dd>@Model.MaDocGia</dd>
                        </div>

                        <div class="dg-profile-info-item">
                            <dt>
                                <i class="bi bi-person-lines-fill"></i>
                                Loại độc giả
                            </dt>
                            <dd>@Model.LoaiDocGia</dd>
                        </div>

                        <div class="dg-profile-info-item">
                            <dt>
                                <i class="bi bi-book"></i>
                                Quyền mượn
                            </dt>
                            <dd>
                                Tối đa @Model.SoSachToiDa cuốn,
                                mỗi lượt @Model.SoNgayMuonToiDa ngày
                            </dd>
                        </div>

                        <div class="dg-profile-info-item">
                            <dt>
                                <i class="bi bi-calendar-plus"></i>
                                Ngày đăng ký
                            </dt>
                            <dd>@Model.NgayDangKy.ToString("dd/MM/yyyy")</dd>
                        </div>

                        <div class="dg-profile-info-item">
                            <dt>
                                <i class="bi bi-calendar-check"></i>
                                Hạn thẻ
                            </dt>
                            <dd>@Model.NgayHetHan.ToString("dd/MM/yyyy")</dd>
                        </div>

                    </dl>

                    @* Thống kê hoạt động *@
                    <div class="dg-profile-statistics">

                        <div class="dg-profile-stat-card">
                            <div class="dg-profile-stat-icon is-borrowing">
                                <i class="bi bi-book-half"></i>
                            </div>

                            <div class="dg-profile-stat-value">
                                @Model.DangMuon
                            </div>

                            <div class="dg-profile-stat-label">
                                Đang mượn
                            </div>
                        </div>

                        <div class="dg-profile-stat-card">
                            <div class="dg-profile-stat-icon is-history">
                                <i class="bi bi-journal-check"></i>
                            </div>

                            <div class="dg-profile-stat-value">
                                @Model.TongLuotMuon
                            </div>

                            <div class="dg-profile-stat-label">
                                Tổng lượt mượn
                            </div>
                        </div>

                        <div class="dg-profile-stat-card">
                            <div class="dg-profile-stat-icon is-fine">
                                <i class="bi bi-wallet2"></i>
                            </div>

                            <div class="dg-profile-stat-value @(Model.PhatChuaNop > 0 ? "is-danger" : "")">
                                @HienThi.Tien(Model.PhatChuaNop)
                            </div>

                            <div class="dg-profile-stat-label">
                                Phạt chưa nộp
                            </div>
                        </div>

                    </div>
                </div>
            </section>

        </div>
    </div>
</div>

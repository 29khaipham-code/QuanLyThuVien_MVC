@model QuanLyThuVien.ViewModels.DocGia.DatTruocIndexViewModel;
@{
    ViewData["Title"] = "Đặt trước";
}

<partial name="_ThongBao" />

<h2 class="mb-1">Đặt trước</h2>
<p class="text-muted">
    Bạn có thể đặt trước tối đa @Model.ToiDa cuốn cùng lúc. Khi có sách, thư viện giữ chỗ cho bạn @Model.SoNgayGiuCho ngày;
    quá hạn mà chưa đến nhận thì yêu cầu sẽ tự hủy.
</p>

@* ---------- Yêu cầu đang hiệu lực ---------- *@
<h5 class="mt-4 mb-2">Đang hiệu lực (@Model.DangHieuLuc.Count / @Model.ToiDa)</h5>

@if (!Model.DangHieuLuc.Any())
{
    <div class="alert alert-info">
        Bạn chưa đặt trước cuốn nào. Hãy mở trang chi tiết của một cuốn đang hết bản và bấm <strong>Đặt trước</strong>.
        <a asp-area="DocGia" asp-controller="Sach" asp-action="Index">Tra cứu sách</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle bg-white border">
            <thead class="table-light">
                <tr>
                    <th>Sách</th>
                    <th>Ngày đặt</th>
                    <th>Trạng thái</th>
                    <th>Chi tiết</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.DangHieuLuc)
                {
                    <tr>
                        <td>
                            <a asp-area="DocGia" asp-controller="Sach" asp-action="ChiTiet" asp-route-id="@d.SachId">@d.TieuDe</a>
                        </td>
                        <td>@d.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
                        <td><span class="badge @d.LopBadge">@d.TrangThaiText</span></td>
                        <td>
                            @if (d.TrangThai == "DangCho")
                            {
                                <span>Vị trí trong hàng đợi: <strong>@d.ViTriHangDoi</strong></span>
                            }
                            else if (d.TrangThai == "DaGiu")
                            {
                                <div>
                                    Đến nhận trước
                                    <strong>@(d.NgayHetHan.HasValue ? d.NgayHetHan.Value.ToString("dd/MM/yyyy HH:mm") : "—")</strong>
                                </div>
                                <div class="small text-muted">@d.ViTriKe @(string.IsNullOrEmpty(d.MaVach) ? "" : "· " + d.MaVach)</div>
                            }
                        </td>
                        <td class="text-end">
                            <form method="post" asp-area="DocGia" asp-controller="DatTruoc" asp-action="Huy"
                                  onsubmit="return confirm('Bạn có chắc muốn hủy đặt trước cuốn này?');" class="d-inline">
                                <input type="hidden" name="id" value="@d.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-x-circle me-1"></i>Hủy
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* ---------- Lịch sử gần đây ---------- *@
@if (Model.LichSu.Any())
{
    <h5 class="mt-4 mb-2">Lịch sử gần đây</h5>
    <div class="table-responsive">
        <table class="table align-middle bg-white border">
            <thead class="table-light">
                <tr>
                    <th>Sách</th>
                    <th>Ngày đặt</th>
                    <th>Kết quả</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.LichSu)
                {
                    <tr>
                        <td>
                            <a asp-area="DocGia" asp-controller="Sach" asp-action="ChiTiet" asp-route-id="@d.SachId">@d.TieuDe</a>
                        </td>
                        <td>@d.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
                        <td><span class="badge @d.LopBadge">@d.TrangThaiText</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
